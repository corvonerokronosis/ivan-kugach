---
import StudioDecoration from "../components/StudioDecoration.astro";
import PageMetadata from "../components/common/PageMetadata.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/global.css";
import { withBasePath } from "../utils/site-path";
import type { JsonLdObject } from "../utils/structured-data";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  socialImage?: string;
  socialImageAlt?: string;
  openGraphType?: "website" | "article";
  structuredData?: JsonLdObject | JsonLdObject[];
  studioDecoration?: boolean;
}

const {
  title,
  description,
  canonical,
  robots,
  socialImage,
  socialImageAlt,
  openGraphType,
  structuredData,
  studioDecoration = false,
} = Astro.props;
const hasHeaderContent = Astro.slots.has("header");
const hasFooter = Astro.slots.has("footer");
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={withBasePath("/favicon.svg")} type="image/svg+xml" />
    <PageMetadata
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      socialImage={socialImage}
      socialImageAlt={socialImageAlt}
      openGraphType={openGraphType}
      structuredData={structuredData}
    />
  </head>
  <body class:list={{ "has-studio-decoration": studioDecoration }}>
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>

    {studioDecoration && <StudioDecoration />}

    <div class="site-shell">
      <header class="site-header">
        <SiteNavigation currentPath={Astro.url.pathname} />
        {
          hasHeaderContent && (
            <div class="site-header__content">
              <slot name="header" />
            </div>
          )
        }
      </header>

      <main id="main-content" class="site-main" tabindex="-1">
        <slot />
      </main>

      {
        hasFooter && (
          <footer
            class:list={[
              "site-footer",
              { "studio-reading-plane": studioDecoration },
            ]}
          >
            <slot name="footer" />
          </footer>
        )
      }
    </div>
  </body>
</html>
