---
import StudioDecoration from "../components/StudioDecoration.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  studioDecoration?: boolean;
}

const { title, description, studioDecoration = false } = Astro.props;
const hasHeaderContent = Astro.slots.has("header");
const hasFooter = Astro.slots.has("footer");
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class:list={{ "has-studio-decoration": studioDecoration }}>
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>

    {studioDecoration && <StudioDecoration />}

    <div class="site-shell">
      <header class="site-header">
        <SiteNavigation currentPath={Astro.url.pathname} />
        {
          hasHeaderContent && (
            <div class="site-header__content">
              <slot name="header" />
            </div>
          )
        }
      </header>

      <main id="main-content" class="site-main" tabindex="-1">
        <slot />
      </main>

      {
        hasFooter && (
          <footer class="site-footer">
            <slot name="footer" />
          </footer>
        )
      }
    </div>
  </body>
</html>
