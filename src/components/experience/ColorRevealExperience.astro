---
import artwork from "../../Kugach_picture_1.png";
import DialogShell from "../common/DialogShell.astro";

interface Props {
  bridgePath: string;
}

const { bridgePath } = Astro.props;
---

<section class="color-reveal" data-color-reveal-page>
  <div class="color-reveal__frame" aria-describedby="color-reveal-hint">
    <div class="color-reveal__stage" data-reveal-container>
      <canvas data-reveal-base aria-hidden="true"></canvas>
      <img
        data-reveal-source
        src={artwork.src}
        alt=""
        hidden
        crossorigin="anonymous"
      />
      <canvas
        data-reveal-layer
        aria-label="Картина Ивана Кугача: проведите по полотну, чтобы раскрыть цвет"
      ></canvas>
      <span class="color-reveal__brush" data-reveal-brush aria-hidden="true"
      ></span>
    </div>
  </div>

  <div class="color-reveal__hud">
    <div class="color-reveal__copy">
      <h2>Возвращение цвета</h2>
      <p>Большая мягкая кисть и ускоренное раскрытие рядом с мазком.</p>
    </div>

    <div class="color-reveal__progress">
      <div class="color-reveal__progress-row">
        <span>Прогресс</span>
        <strong data-reveal-progress-text>0%</strong>
      </div>
      <progress data-reveal-progress value="0" max="100">0%</progress>
    </div>

    <button
      class="color-reveal__reset"
      type="button"
      data-reveal-reset
      aria-label="Сбросить раскрытие цвета"
    >
      Сбросить
    </button>
    <button
      class="color-reveal__complete"
      type="button"
      data-reveal-complete
      aria-label="Раскрыть картину полностью без жеста"
    >
      Показать полностью
    </button>
  </div>

  <p
    id="color-reveal-hint"
    class="color-reveal__hint"
    data-reveal-status
    aria-live="polite"
  >
    Зажмите и ведите курсором или пальцем по картине либо нажмите «Показать
    полностью».
  </p>

  <DialogShell
    id="color-reveal-complete-dialog"
    title="Краткая история полотна"
    description="Картина раскрыта"
  >
    <p>
      Здесь можно показать информацию о картине: автора, название, год создания
      и короткий рассказ о сюжете или месте этой работы в творчестве художника.
    </p>
    <p>
      В прототипе текст универсальный, но блок уже готов для замены на реальные
      музейные данные.
    </p>

    <Fragment slot="actions">
      <a class="color-reveal__dialog-action" href={bridgePath}>
        Продолжить историю
      </a>
      <button
        class="color-reveal__dialog-action"
        type="button"
        data-reveal-dialog-reset
      >
        Раскрасить ещё раз
      </button>
      <button
        class="color-reveal__dialog-action color-reveal__dialog-action--quiet"
        type="button"
        data-reveal-dialog-close
      >
        Закрыть
      </button>
    </Fragment>
  </DialogShell>
</section>

<script>
  import "../../scripts/color-reveal-page";
</script>

<style>
  .color-reveal {
    display: grid;
    gap: var(--space-4);
    padding: clamp(var(--space-3), 2vw, var(--space-6));
    border-radius: var(--radius-2xl);
    background: linear-gradient(
      180deg,
      rgb(255 248 236 / 72%),
      rgb(247 234 211 / 88%)
    );
    box-shadow: var(--shadow-raised);
  }

  .color-reveal__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 18rem;
    overflow: hidden;
    border: 0.5rem solid var(--color-wood-strong);
    border-radius: var(--radius-xl);
    aspect-ratio: 1.96 / 1;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 14%), transparent 48%),
      var(--palette-sand-300);
    box-shadow:
      0 0 0 0.9rem rgb(255 245 224 / 78%),
      var(--shadow-surface);
    touch-action: none;
    user-select: none;
  }

  .color-reveal__stage {
    position: relative;
    width: auto;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    overflow: hidden;
    aspect-ratio: 579 / 480;
    touch-action: none;
    user-select: none;
  }

  .color-reveal__stage canvas {
    position: absolute;
    display: block;
  }

  .color-reveal__stage [data-reveal-base] {
    z-index: 1;
    background: var(--palette-sand-300);
  }

  .color-reveal__stage [data-reveal-layer] {
    z-index: 2;
    cursor: none;
  }

  .color-reveal__brush {
    position: absolute;
    z-index: 3;
    width: 5.25rem;
    height: 5.25rem;
    margin: -2.625rem 0 0 -2.625rem;
    border-radius: var(--radius-round);
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      circle,
      rgb(255 255 255 / 16%) 0 26%,
      rgb(139 75 45 / 20%) 27% 52%,
      rgb(47 36 25 / 55%) 53% 56%,
      transparent 57%
    );
    filter: drop-shadow(0 0.375rem 0.75rem rgb(0 0 0 / 24%));
    mix-blend-mode: multiply;
    transition: opacity var(--motion-duration-base)
      var(--motion-easing-standard);
  }

  .color-reveal__hud {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-text-on-accent);
    background: rgb(34 26 19 / 78%);
    backdrop-filter: blur(0.625rem);
  }

  .color-reveal__copy {
    display: grid;
    gap: var(--space-1);
  }

  .color-reveal__copy h2 {
    margin: 0;
    font-size: var(--font-size-300);
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .color-reveal__copy p {
    margin: 0;
    color: rgb(255 247 236 / 80%);
    font-size: var(--font-size-200);
  }

  .color-reveal__progress {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .color-reveal__progress-row {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
  }

  .color-reveal__progress progress {
    width: 100%;
    height: 0.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(255 248 236 / 18%);
    overflow: hidden;
  }

  .color-reveal__progress progress::-webkit-progress-bar {
    border-radius: inherit;
    background: rgb(255 248 236 / 18%);
  }

  .color-reveal__progress progress::-webkit-progress-value {
    border-radius: inherit;
    background: linear-gradient(90deg, #d59153, #f4d28f);
    box-shadow: 0 0 1.25rem rgb(244 210 143 / 40%);
  }

  .color-reveal__progress progress::-moz-progress-bar {
    border-radius: inherit;
    background: linear-gradient(90deg, #d59153, #f4d28f);
    box-shadow: 0 0 1.25rem rgb(244 210 143 / 40%);
  }

  .color-reveal__reset,
  .color-reveal__complete,
  .color-reveal__dialog-action {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .color-reveal__reset {
    border-color: rgb(255 248 236 / 22%);
    color: var(--color-text-on-accent);
    background: rgb(255 248 236 / 14%);
  }

  .color-reveal__complete {
    border-color: rgb(255 248 236 / 28%);
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
  }

  .color-reveal__complete:disabled {
    cursor: not-allowed;
    opacity: 0.62;
  }

  .color-reveal__dialog-action {
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
    box-shadow: 0 10px 24px rgb(94 39 23 / 20%);
  }

  .color-reveal__dialog-action:hover {
    color: var(--color-text-on-accent);
    background: var(--color-accent);
  }

  .color-reveal__dialog-action--quiet {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-strong);
    box-shadow: none;
  }

  .color-reveal__dialog-action--quiet:hover {
    color: var(--color-accent-strong);
    background: var(--color-surface-muted);
  }

  .color-reveal__hint {
    margin: 0;
    padding-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    text-align: center;
  }

  @media (min-width: 48rem) {
    .color-reveal__hud {
      grid-template-columns: minmax(11rem, 0.34fr) minmax(0, 1fr) auto auto;
    }
  }

  @media (max-width: 45rem) {
    .color-reveal {
      padding: var(--space-3);
      border-radius: var(--radius-xl);
    }

    .color-reveal__frame {
      min-height: 17.5rem;
      border-width: 0.375rem;
      border-radius: var(--radius-md);
      aspect-ratio: 1.08 / 1;
      box-shadow:
        0 0 0 0.625rem rgb(255 245 224 / 78%),
        var(--shadow-surface);
    }

    .color-reveal__hud,
    .color-reveal__reset,
    .color-reveal__complete,
    .color-reveal__dialog-action {
      width: 100%;
    }

    .color-reveal__brush {
      width: 4.5rem;
      height: 4.5rem;
      margin: -2.25rem 0 0 -2.25rem;
    }
  }
</style>
