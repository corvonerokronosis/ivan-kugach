---
import artwork from "../../assets/images/interactive/color-reveal/kugach-picture-1.png";
import Action from "../common/Action.astro";
import DialogShell from "../common/DialogShell.astro";
import OptimizedImage from "../common/OptimizedImage.astro";

interface Props {
  bridgePath: string;
}

const { bridgePath } = Astro.props;
---

<section class="color-reveal" data-color-reveal-page>
  <div class="color-reveal__workspace">
    <div class="color-reveal__frame" aria-describedby="color-reveal-hint">
      <div class="color-reveal__stage" data-reveal-container>
        <canvas data-reveal-base aria-hidden="true"></canvas>
        <OptimizedImage
          data-reveal-source
          src={artwork.src}
          alt=""
          variant="interactive"
          fit="contain"
          priority
          hidden
          crossorigin="anonymous"
        />
        <canvas
          data-reveal-layer
          aria-label="Картина Ивана Кугача: проведите по полотну, чтобы раскрыть цвет"
        ></canvas>
        <span class="color-reveal__brush" data-reveal-brush aria-hidden="true"
        ></span>
      </div>
    </div>

    <aside class="color-reveal__hud" aria-label="Управление раскрытием цвета">
      <div class="color-reveal__copy">
        <h2>Возвращение цвета</h2>
        <p>Большая мягкая кисть и ускоренное раскрытие рядом с мазком.</p>
      </div>

      <div class="color-reveal__progress">
        <div class="color-reveal__progress-row">
          <span>Прогресс</span>
          <strong data-reveal-progress-text>0%</strong>
        </div>
        <progress data-reveal-progress value="0" max="100">0%</progress>
      </div>

      <div class="color-reveal__controls">
        <Action
          class="color-reveal__control color-reveal__control--primary"
          type="button"
          data-reveal-complete
          aria-label="Раскрыть картину полностью без жеста"
        >
          Показать полностью
        </Action>
        <Action
          class="color-reveal__control color-reveal__control--quiet"
          variant="quiet"
          type="button"
          data-reveal-reset
          aria-label="Сбросить раскрытие цвета"
        >
          Сбросить
        </Action>
      </div>

      <p
        id="color-reveal-hint"
        class="color-reveal__hint"
        data-reveal-status
        aria-live="polite"
      >
        Зажмите и ведите курсором или пальцем по картине либо нажмите «Показать
        полностью».
      </p>
    </aside>
  </div>

  <DialogShell
    id="color-reveal-complete-dialog"
    title="Краткая история полотна"
    description="Картина раскрыта"
  >
    <p>
      Здесь можно показать информацию о картине: автора, название, год создания
      и короткий рассказ о сюжете или месте этой работы в творчестве художника.
    </p>
    <p>
      В прототипе текст универсальный, но блок уже готов для замены на реальные
      музейные данные.
    </p>

    <Fragment slot="actions">
      <Action href={bridgePath}> Продолжить историю </Action>
      <Action type="button" data-reveal-dialog-reset>
        Раскрасить ещё раз
      </Action>
      <Action variant="secondary" type="button" data-reveal-dialog-close>
        Закрыть
      </Action>
    </Fragment>
  </DialogShell>
</section>

<style>
  .color-reveal {
    display: grid;
    gap: var(--space-4);
  }

  .color-reveal__workspace {
    display: grid;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
    align-items: stretch;
  }

  .color-reveal__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 20rem;
    padding: clamp(var(--space-4), 2.4vw, var(--space-7));
    overflow: hidden;
    border: var(--frame-border-width) solid var(--color-wood-strong);
    border-radius: var(--frame-radius);
    aspect-ratio: 1.46 / 1;
    background:
      linear-gradient(135deg, var(--color-lamp-muted), transparent 42%),
      repeating-linear-gradient(
        105deg,
        var(--color-border-subtle) 0 1px,
        transparent 1px 1.75rem
      ),
      var(--color-linen);
    box-shadow:
      inset 0 0 0 var(--frame-inner-border-width) var(--color-wood-highlight),
      inset 0 0 0 calc(var(--frame-inner-border-width) + 0.25rem)
        var(--color-wood),
      var(--shadow-frame);
    touch-action: none;
    user-select: none;
  }

  .color-reveal__frame::after {
    position: absolute;
    right: 8%;
    bottom: 0;
    left: 8%;
    height: 0.9rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      90deg,
      var(--color-wood-strong),
      var(--color-wood-highlight),
      var(--color-wood-strong)
    );
    box-shadow: var(--shadow-surface);
    content: "";
  }

  .color-reveal__stage {
    position: relative;
    width: auto;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    aspect-ratio: 579 / 480;
    background: var(--color-linen-muted);
    box-shadow: var(--shadow-surface);
    touch-action: none;
    user-select: none;
  }

  .color-reveal__stage canvas {
    position: absolute;
    display: block;
  }

  .color-reveal__stage [data-reveal-base] {
    z-index: 1;
    background: var(--color-linen-muted);
  }

  .color-reveal__stage [data-reveal-layer] {
    z-index: 2;
    cursor: none;
  }

  .color-reveal__brush {
    position: absolute;
    z-index: 3;
    width: 5.25rem;
    height: 5.25rem;
    margin: -2.625rem 0 0 -2.625rem;
    border-radius: var(--radius-round);
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      circle,
      rgb(255 255 255 / 16%) 0 26%,
      rgb(139 75 45 / 20%) 27% 52%,
      rgb(47 36 25 / 55%) 53% 56%,
      transparent 57%
    );
    filter: drop-shadow(0 0.375rem 0.75rem rgb(0 0 0 / 24%));
    mix-blend-mode: multiply;
    transition: opacity var(--motion-duration-base)
      var(--motion-easing-standard);
  }

  .color-reveal__hud {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background:
      linear-gradient(145deg, var(--color-lamp-muted), transparent 38%),
      color-mix(in srgb, var(--color-surface) 88%, var(--color-wall));
    box-shadow: var(--shadow-surface);
  }

  .color-reveal__copy {
    display: grid;
    gap: var(--space-1);
  }

  .color-reveal__copy h2 {
    margin: 0;
    font-size: var(--font-size-heading-sm);
  }

  .color-reveal__copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
  }

  .color-reveal__progress {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .color-reveal__progress-row {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .color-reveal__progress progress {
    width: 100%;
    height: 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-wall-muted);
    overflow: hidden;
  }

  .color-reveal__progress progress::-webkit-progress-bar {
    border-radius: inherit;
    background: var(--color-wall-muted);
  }

  .color-reveal__progress progress::-webkit-progress-value {
    border-radius: inherit;
    background: var(--color-accent);
  }

  .color-reveal__progress progress::-moz-progress-bar {
    border-radius: inherit;
    background: var(--color-accent);
  }

  .color-reveal__controls {
    display: grid;
    gap: var(--space-2);
  }

  .color-reveal__hud :global(.color-reveal__control) {
    width: 100%;
    min-height: 2.75rem;
    justify-content: center;
  }

  .color-reveal__hud :global(.color-reveal__control--quiet) {
    border-color: var(--color-border);
    color: var(--color-text);
    background: transparent;
  }

  .color-reveal__hud :global(.color-reveal__control--primary) {
    border-color: var(--color-accent-strong);
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
  }

  .color-reveal__hint {
    margin: 0;
    align-self: end;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    text-wrap: pretty;
  }

  @media (min-width: 62rem) {
    .color-reveal__workspace {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.34fr);
    }
  }

  @media (max-width: 45rem) {
    .color-reveal__frame {
      min-height: 16rem;
      padding: var(--space-4);
      border-width: 0.375rem;
      aspect-ratio: 1.08 / 1;
    }

    .color-reveal__hud,
    .color-reveal :global(.dialog-shell__actions .action) {
      width: 100%;
    }

    .color-reveal__brush {
      width: 4.5rem;
      height: 4.5rem;
      margin: -2.25rem 0 0 -2.25rem;
    }
  }
</style>
