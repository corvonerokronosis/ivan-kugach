---
import type { Hotspot } from "../../types/hotspot";
import Action from "../common/Action.astro";
import DialogShell from "../common/DialogShell.astro";
import OptimizedImage from "../common/OptimizedImage.astro";

interface Props {
  hotspots: Hotspot[];
  lightBridgePath: string;
  catalogPath: string;
}

const { hotspots, lightBridgePath, catalogPath } = Astro.props;
const artwork = hotspots[0]?.image;
const viewportAriaLabel = [
  "Область просмотра картины. Используйте колесо или кнопки для масштаба,",
  "перетаскивание для перемещения, стрелки клавиатуры для сдвига.",
].join(" ");

function getHotspotPositionStyle(hotspot: Hotspot): string {
  return [
    `left: ${hotspot.position.x * 100}%`,
    `top: ${hotspot.position.y * 100}%`,
  ].join("; ");
}

if (!artwork) {
  throw new Error("Details explorer: не найдено изображение для hotspots");
}
---

<section class="details-explorer" data-details-explorer>
  <div class="details-explorer__workspace">
    <div class="details-explorer__stage">
      <div
        class="details-explorer__viewport"
        data-details-viewport
        tabindex="0"
        role="application"
        aria-label={viewportAriaLabel}
        aria-describedby="details-explorer-instructions"
      >
        <div class="details-explorer__canvas" data-details-content>
          <OptimizedImage
            data-details-image
            src={artwork.src}
            alt={artwork.alt}
            variant="interactive"
            fit="contain"
            priority
            draggable="false"
          />
          {
            hotspots.map((hotspot) => (
              <button
                type="button"
                class="details-explorer__hotspot"
                style={getHotspotPositionStyle(hotspot)}
                data-details-hotspot
                data-zoom-pan-ignore
                data-hotspot-id={hotspot.id}
                data-hotspot-x={hotspot.position.x}
                data-hotspot-y={hotspot.position.y}
                data-hotspot-scale={hotspot.targetScale}
                data-hotspot-label={hotspot.label}
                data-hotspot-title={hotspot.title}
                data-hotspot-text={hotspot.text}
                aria-label={`${hotspot.label}: ${hotspot.title}`}
                aria-pressed="false"
              >
                <span class="details-explorer__hotspot-number">
                  {hotspot.order}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="details-explorer__hud">
      <div class="details-explorer__zoom" aria-label="Управление масштабом">
        <strong>Масштаб</strong>
        <Action
          type="button"
          variant="secondary"
          data-details-zoom-out
          ariaLabel="Уменьшить масштаб"
        >
          −
        </Action>
        <output data-details-scale aria-live="polite">0%</output>
        <Action
          type="button"
          variant="secondary"
          data-details-zoom-in
          ariaLabel="Увеличить масштаб"
        >
          +
        </Action>
        <Action type="button" variant="secondary" data-details-reset
          >Сбросить</Action
        >
      </div>

      <div class="details-explorer__progress" aria-live="polite">
        <strong>Прогресс исследования</strong>
        <p data-details-progress>
          Открыто точек: 0 из {hotspots.length}. Выбирайте точки кнопками,
          меняйте масштаб кнопками и двигайте вид стрелками клавиатуры.
        </p>
        <Action
          class="details-explorer__continue"
          data-details-continue
          href={lightBridgePath}
          hidden
        >
          Перейти к свету
        </Action>
      </div>
    </div>
  </div>

  <p id="details-explorer-instructions" class="details-explorer__instructions">
    Выбирайте точки на картине кнопками. Масштаб меняется кнопками, колесом,
    клавишами + и −; стрелки клавиатуры двигают картину, 0 сбрасывает вид.
    Перетаскивание мышью или пальцем остаётся дополнительным способом.
  </p>

  <DialogShell
    id="details-hotspot-dialog"
    title="Деталь картины"
    description="Точка исследования"
  >
    <p class="details-explorer__dialog-label" data-details-dialog-label></p>
    <p data-details-dialog-text></p>

    <Fragment slot="actions">
      <Action type="button" data-details-dialog-close>
        Продолжить просмотр
      </Action>
    </Fragment>
  </DialogShell>

  <DialogShell
    id="details-complete-dialog"
    title="Все точки уже открыты"
    description="Исследование завершено"
  >
    <p>
      Вы можете остаться в этом экране и дальше рассматривать картину в
      свободном режиме или перейти к следующему блоку истории.
    </p>

    <Fragment slot="actions">
      <Action variant="secondary" type="button" data-details-complete-close>
        Остаться у картины
      </Action>
      <Action href={lightBridgePath}> К мастерской света </Action>
      <Action variant="quiet" href={catalogPath}> Работы для покупки </Action>
    </Fragment>
  </DialogShell>
</section>

<style>
  .details-explorer {
    display: grid;
    min-width: 0;
    gap: var(--space-4);
  }

  .details-explorer__workspace {
    display: grid;
    min-width: 0;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
    align-items: stretch;
  }

  /* The engine owns the transformed canvas. Keep its viewport independent
     from the frame and reserve its height before the image is decoded. */
  .details-explorer__stage {
    position: relative;
    min-width: 0;
    height: clamp(25rem, 62vh, 38rem);
    padding: clamp(var(--space-3), 2vw, var(--space-6));
    overflow: hidden;
    border: var(--frame-border-width) solid var(--color-wood-strong);
    border-radius: var(--frame-radius);
    background:
      linear-gradient(135deg, var(--color-lamp-muted), transparent 42%),
      var(--color-wood);
    box-shadow:
      inset 0 0 0 var(--frame-inner-border-width) var(--color-wood-highlight),
      var(--shadow-frame);
  }

  .details-explorer__viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-wood-strong);
    border-radius: var(--radius-sm);
    background: var(--color-linen);
    box-shadow: var(--shadow-inset-border);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .details-explorer__viewport[data-zoom-pan-dragging="true"] {
    cursor: grabbing;
  }

  .details-explorer__viewport:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(-1 * var(--focus-ring-width));
  }

  .details-explorer__canvas {
    position: absolute;
    inset: 0 auto auto 0;
    overflow: hidden;
    transform-origin: 0 0;
    will-change: transform;
  }

  .details-explorer__canvas :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .details-explorer__hotspot {
    position: absolute;
    z-index: 2;
    --hotspot-interaction-scale: 1;

    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-round);
    color: var(--color-text-on-accent);
    background: transparent;
    cursor: pointer;
    transform: scale(
      calc((1 / var(--zoom-pan-scale, 1)) * var(--hotspot-interaction-scale))
    );
    transform-origin: center;
  }

  .details-explorer__hotspot::before {
    position: absolute;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-linen-strong);
    border-radius: inherit;
    background: var(--color-accent-strong);
    box-shadow:
      0 0 0 1px var(--color-wood-strong),
      var(--shadow-surface);
    content: "";
    pointer-events: none;
  }

  .details-explorer__hotspot:hover,
  .details-explorer__hotspot[aria-pressed="true"] {
    --hotspot-interaction-scale: 1.12;
  }

  .details-explorer__hotspot:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-linen-strong);
    outline-offset: 1px;
    box-shadow: 0 0 0 5px var(--color-wood-strong);
  }

  .details-explorer__hotspot:active {
    --hotspot-interaction-scale: 0.96;
  }

  .details-explorer__hotspot[data-viewed="true"]::before {
    border-style: double;
    border-width: 4px;
    background: var(--color-wood-strong);
  }

  .details-explorer__hotspot[data-viewed="true"] {
    color: var(--color-text-on-dark);
  }

  .details-explorer__hotspot-number {
    position: relative;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .details-explorer__hud {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
    align-content: start;
    padding: clamp(var(--space-5), 3vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background:
      linear-gradient(145deg, var(--color-lamp-muted), transparent 38%),
      color-mix(in srgb, var(--color-surface) 88%, var(--color-wall));
    box-shadow: var(--shadow-surface);
  }

  .details-explorer__zoom {
    display: grid;
    grid-template-columns: 2.75rem minmax(4ch, 1fr) 2.75rem;
    gap: var(--space-2);
    align-items: center;
    min-width: 0;
  }

  .details-explorer__zoom strong {
    grid-column: 1 / -1;
    margin-bottom: var(--space-2);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
  }

  .details-explorer__zoom :global(.action) {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: var(--space-2);
  }

  .details-explorer__zoom :global([data-details-reset]) {
    grid-column: 1 / -1;
  }

  .details-explorer__zoom output {
    min-width: 0;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-500);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .details-explorer__progress {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .details-explorer__progress strong {
    font-size: var(--font-size-heading-sm);
    line-height: var(--line-height-heading);
  }

  .details-explorer__progress p {
    margin: 0;
    min-height: 9lh;
    color: var(--color-text);
    font-size: var(--font-size-200);
  }

  .details-explorer__dialog-label {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .details-explorer :global(.details-explorer__continue[hidden]) {
    display: none;
  }

  .details-explorer__instructions {
    max-width: 90ch;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-text-muted);
    background: var(--color-wall-muted);
    font-size: var(--font-size-200);
  }

  .details-explorer :global(.dialog-shell__body) {
    font-size: var(--font-size-400);
  }

  @media (min-width: 62rem) {
    .details-explorer__workspace {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.34fr);
    }
  }

  @media (max-width: 61.999rem) {
    .details-explorer__progress p {
      min-height: 3lh;
    }
  }

  @media (min-width: 42rem) and (max-width: 61.999rem) {
    .details-explorer__hud {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    }

    .details-explorer__progress {
      padding-top: 0;
      padding-left: var(--space-5);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }

  @media (max-width: 41.999rem) {
    .details-explorer__stage {
      height: clamp(22rem, 58svh, 30rem);
      padding: var(--space-3);
      border-width: 0.375rem;
    }

    .details-explorer :global(.details-explorer__continue),
    .details-explorer :global(.dialog-shell__actions .action) {
      width: 100%;
    }
  }
</style>
