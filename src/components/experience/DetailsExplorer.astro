---
import type { Hotspot } from "../../types/hotspot";
import DialogShell from "../common/DialogShell.astro";
import OptimizedImage from "../common/OptimizedImage.astro";

interface Props {
  hotspots: Hotspot[];
  lightBridgePath: string;
  catalogPath: string;
}

const { hotspots, lightBridgePath, catalogPath } = Astro.props;
const artwork = hotspots[0]?.image;

if (!artwork) {
  throw new Error("Details explorer: не найдено изображение для hotspots");
}
---

<section class="details-explorer" data-details-explorer>
  <div class="details-explorer__workspace">
    <div class="details-explorer__stage">
      <div
        class="details-explorer__viewport"
        data-details-viewport
        tabindex="0"
        role="application"
        aria-label="Область просмотра картины. Используйте колесо или кнопки для масштаба, перетаскивание для перемещения, стрелки клавиатуры для сдвига."
        aria-describedby="details-explorer-instructions"
      >
        <div class="details-explorer__canvas" data-details-content>
          <OptimizedImage
            data-details-image
            src={artwork.src}
            alt={artwork.alt}
            variant="interactive"
            priority
            draggable="false"
          />
          {
            hotspots.map((hotspot) => (
              <button
                type="button"
                class="details-explorer__hotspot"
                style={`left: ${hotspot.position.x * 100}%; top: ${hotspot.position.y * 100}%;`}
                data-details-hotspot
                data-zoom-pan-ignore
                data-hotspot-id={hotspot.id}
                data-hotspot-x={hotspot.position.x}
                data-hotspot-y={hotspot.position.y}
                data-hotspot-scale={hotspot.targetScale}
                data-hotspot-label={hotspot.label}
                data-hotspot-title={hotspot.title}
                data-hotspot-text={hotspot.text}
                aria-label={`${hotspot.label}: ${hotspot.title}`}
                aria-pressed="false"
              >
                <span class="details-explorer__hotspot-number">
                  {hotspot.order}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="details-explorer__hud">
      <div class="details-explorer__zoom" aria-label="Управление масштабом">
        <strong>Масштаб</strong>
        <button
          type="button"
          data-details-zoom-out
          aria-label="Уменьшить масштаб"
        >
          −
        </button>
        <output data-details-scale aria-live="polite">0%</output>
        <button
          type="button"
          data-details-zoom-in
          aria-label="Увеличить масштаб"
        >
          +
        </button>
        <button type="button" data-details-reset>Сбросить</button>
      </div>

      <div class="details-explorer__progress" aria-live="polite">
        <strong>Прогресс исследования</strong>
        <p data-details-progress>
          Открыто точек: 0 из {hotspots.length}. Выбирайте точки кнопками,
          меняйте масштаб кнопками и двигайте вид стрелками клавиатуры.
        </p>
        <a
          class="details-explorer__continue"
          data-details-continue
          href={lightBridgePath}
          hidden
        >
          Перейти к свету
        </a>
      </div>
    </div>
  </div>

  <p id="details-explorer-instructions" class="details-explorer__instructions">
    Выбирайте точки на картине кнопками. Масштаб меняется кнопками, колесом,
    клавишами + и −; стрелки клавиатуры двигают картину, 0 сбрасывает вид.
    Перетаскивание мышью или пальцем остаётся дополнительным способом.
  </p>

  <DialogShell
    id="details-hotspot-dialog"
    title="Деталь картины"
    description="Точка исследования"
  >
    <p class="details-explorer__dialog-label" data-details-dialog-label></p>
    <p data-details-dialog-text></p>

    <Fragment slot="actions">
      <button
        class="details-explorer__dialog-action"
        type="button"
        data-details-dialog-close
      >
        Продолжить просмотр
      </button>
    </Fragment>
  </DialogShell>

  <DialogShell
    id="details-complete-dialog"
    title="Все точки уже открыты"
    description="Исследование завершено"
  >
    <p>
      Вы можете остаться в этом экране и дальше рассматривать картину в
      свободном режиме или перейти к следующему блоку истории.
    </p>

    <Fragment slot="actions">
      <button
        class="details-explorer__dialog-action details-explorer__dialog-action--secondary"
        type="button"
        data-details-complete-close
      >
        Остаться у картины
      </button>
      <a class="details-explorer__dialog-action" href={lightBridgePath}>
        К мастерской света
      </a>
      <a
        class="details-explorer__dialog-action details-explorer__dialog-action--quiet"
        href={catalogPath}
      >
        Работы для покупки
      </a>
    </Fragment>
  </DialogShell>
</section>

<style>
  .details-explorer {
    display: grid;
    min-width: 0;
    gap: var(--space-4);
  }

  .details-explorer__workspace {
    min-width: 0;
    padding: clamp(var(--space-3), 2.3vw, var(--space-6));
    overflow: hidden;
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(
        circle at top left,
        rgb(255 255 255 / 58%),
        transparent 34%
      ),
      linear-gradient(180deg, rgb(255 249 241 / 76%), rgb(235 214 186 / 92%));
    box-shadow: var(--shadow-raised);
  }

  .details-explorer__stage {
    position: relative;
    min-width: 0;
    height: clamp(30rem, 68vh, 43rem);
    padding: clamp(var(--space-4), 2vw, var(--space-7));
    overflow: hidden;
    border: 0.875rem solid #5d371f;
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, #7d5534, #4c2e1e 42%, #2c180f);
    box-shadow:
      inset 0 0 0 2px rgb(235 194 110 / 42%),
      0 28px 56px rgb(34 20 12 / 28%);
  }

  .details-explorer__stage::before {
    position: absolute;
    z-index: 0;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      135deg,
      rgb(255 219 160 / 42%),
      rgb(122 77 42 / 14%) 34%,
      rgb(35 18 10 / 28%)
    );
    box-shadow:
      inset 0 0 0 1px rgb(255 230 193 / 30%),
      inset 0 0 0 10px rgb(117 71 38 / 24%);
    content: "";
    inset: clamp(var(--space-2), 1.2vw, var(--space-4));
    pointer-events: none;
  }

  .details-explorer__viewport {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 8%), transparent 30%), #9c7351;
    box-shadow:
      inset 0 0 0 1px rgb(79 46 25 / 42%),
      inset 0 18px 32px rgb(255 246 232 / 8%);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .details-explorer__viewport[data-zoom-pan-dragging="true"] {
    cursor: grabbing;
  }

  .details-explorer__viewport:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(-1 * var(--focus-ring-width));
  }

  .details-explorer__canvas {
    position: absolute;
    inset: 0 auto auto 0;
    overflow: hidden;
    cursor: grab;
    transform-origin: 0 0;
    will-change: transform;
  }

  .details-explorer__canvas img {
    display: block;
    width: 100%;
    height: 100%;
    filter: saturate(0.96) contrast(1.02);
    pointer-events: none;
    user-select: none;
  }

  .details-explorer__hotspot {
    position: absolute;
    z-index: 2;
    width: 1.625rem;
    height: 1.625rem;
    margin: -0.8125rem 0 0 -0.8125rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-round);
    background: radial-gradient(
      circle at 35% 35%,
      rgb(255 249 240 / 96%),
      rgb(233 172 93 / 94%) 58%,
      rgb(133 72 38 / 98%)
    );
    box-shadow:
      0 0 0 1px rgb(255 244 229 / 48%),
      0 0 0 10px rgb(240 178 98 / 12%),
      0 12px 24px rgb(17 11 8 / 30%);
    cursor: pointer;
    transition:
      transform var(--motion-duration-base) var(--motion-easing-standard),
      box-shadow var(--motion-duration-base) var(--motion-easing-standard);
  }

  .details-explorer__hotspot::before,
  .details-explorer__hotspot::after {
    position: absolute;
    border-radius: var(--radius-round);
    content: "";
    inset: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .details-explorer__hotspot::before {
    width: 0.625rem;
    height: 0.625rem;
    background: rgb(77 36 14 / 88%);
  }

  .details-explorer__hotspot::after {
    width: 100%;
    height: 100%;
    border: 1px solid rgb(252 223 174 / 70%);
    animation: details-hotspot-pulse 2.6s ease-out infinite;
  }

  .details-explorer__hotspot:hover,
  .details-explorer__hotspot:focus-visible,
  .details-explorer__hotspot[aria-pressed="true"] {
    outline: none;
    box-shadow:
      0 0 0 2px rgb(255 244 229 / 84%),
      0 0 0 14px rgb(240 178 98 / 18%),
      0 18px 30px rgb(17 11 8 / 35%);
    transform: scale(1.12);
  }

  .details-explorer__hotspot[data-viewed="true"] {
    box-shadow:
      0 0 0 2px var(--color-status-success),
      0 0 0 10px rgb(52 91 49 / 16%),
      0 12px 24px rgb(17 11 8 / 30%);
  }

  .details-explorer__hotspot-number {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .details-explorer__hud {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .details-explorer__zoom,
  .details-explorer__progress {
    min-width: 0;
    border-radius: var(--radius-md);
  }

  .details-explorer__zoom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3);
    color: var(--color-text-on-accent);
    background: linear-gradient(
      180deg,
      rgb(58 37 24 / 92%),
      rgb(38 24 16 / 92%)
    );
    border: 1px solid rgb(235 205 150 / 24%);
  }

  .details-explorer__zoom strong {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .details-explorer__zoom button,
  .details-explorer__dialog-action,
  .details-explorer__continue {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .details-explorer__zoom button {
    border-color: rgb(255 248 236 / 18%);
    color: inherit;
    background: rgb(255 248 236 / 12%);
  }

  .details-explorer__zoom button:hover,
  .details-explorer__zoom button:focus-visible {
    background: rgb(255 248 236 / 22%);
  }

  .details-explorer__zoom output {
    min-width: 3rem;
    font-family: var(--font-family-ui);
    font-size: var(--font-size-500);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .details-explorer__progress {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background: rgb(255 249 241 / 72%);
  }

  .details-explorer__progress strong,
  .details-explorer__dialog-label {
    color: rgb(47 36 25 / 56%);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .details-explorer__progress p,
  .details-explorer__dialog-label {
    margin: 0;
  }

  .details-explorer__continue,
  .details-explorer__dialog-action {
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
  }

  .details-explorer__continue[hidden] {
    display: none;
  }

  .details-explorer__instructions {
    margin: 0;
    padding-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    text-align: center;
  }

  .details-explorer__dialog-action--secondary {
    border-color: var(--color-border);
    color: var(--color-text);
    background: linear-gradient(180deg, #f5ddb0, #e5bb70);
  }

  .details-explorer__dialog-action--quiet {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-strong);
  }

  .details-explorer :global(.dialog-shell__body) {
    font-size: var(--font-size-400);
  }

  @media (min-width: 58rem) {
    .details-explorer__hud {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  @media (max-width: 45rem) {
    .details-explorer__workspace {
      padding: var(--space-3);
      border-radius: var(--radius-xl);
    }

    .details-explorer__stage {
      height: 32rem;
      padding: var(--space-3);
      border-width: 0.375rem;
    }

    .details-explorer__zoom,
    .details-explorer__progress,
    .details-explorer__continue,
    .details-explorer__dialog-action {
      width: 100%;
    }

    .details-explorer__zoom {
      display: grid;
      grid-template-columns: minmax(0, 1fr) repeat(3, auto);
    }

    .details-explorer__zoom strong {
      grid-column: 1 / -1;
    }

    .details-explorer__zoom button:last-child {
      grid-column: 1 / -1;
    }

    .details-explorer__instructions {
      text-align: left;
    }
  }

  @keyframes details-hotspot-pulse {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(0.78);
    }

    75%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(2.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .details-explorer__hotspot::after {
      animation: none;
    }
  }
</style>
