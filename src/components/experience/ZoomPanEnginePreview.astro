---
import DialogShell from "../common/DialogShell.astro";
import { getHotspots } from "../../data/repository";
import type { Hotspot } from "../../types/hotspot";
import OptimizedImage from "../common/OptimizedImage.astro";

const hotspots = getHotspots();
const image = hotspots[0]?.image;

function getHotspotPositionStyle(hotspot: Hotspot): string {
  return [
    `left: ${hotspot.position.x * 100}%`,
    `top: ${hotspot.position.y * 100}%`,
  ].join("; ");
}
---

<section class="zoom-preview" data-zoom-pan-preview>
  <div
    class="zoom-preview__viewport"
    data-zoom-pan-viewport
    aria-label="Техническая проверка zoom/pan"
    role="application"
  >
    <div class="zoom-preview__content" data-zoom-pan-content>
      <OptimizedImage
        data-zoom-pan-image
        src={image.src}
        alt={image.alt}
        variant="interactive"
        draggable="false"
      />
      {
        hotspots.map((hotspot) => (
          <button
            type="button"
            class="zoom-preview__hotspot"
            style={getHotspotPositionStyle(hotspot)}
            data-zoom-pan-hotspot
            data-zoom-pan-ignore
            data-hotspot-id={hotspot.id}
            data-hotspot-x={hotspot.position.x}
            data-hotspot-y={hotspot.position.y}
            data-hotspot-scale={hotspot.targetScale}
            data-hotspot-label={hotspot.label}
            data-hotspot-title={hotspot.title}
            data-hotspot-text={hotspot.text}
            aria-label={`${hotspot.label}: ${hotspot.title}`}
            aria-pressed="false"
          >
            <span>{hotspot.order}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="zoom-preview__status" aria-live="polite">
    <span>Масштаб: <strong data-zoom-pan-scale>0%</strong></span>
    <span>Позиция: <strong data-zoom-pan-position>0, 0</strong></span>
    <span>
      Точки: <strong data-zoom-pan-progress>0 из {hotspots.length}</strong>
    </span>
    <span>Состояние: <strong data-zoom-pan-status>active</strong></span>
  </div>

  <div class="zoom-preview__actions">
    <button type="button" data-zoom-pan-in>Приблизить</button>
    <button type="button" data-zoom-pan-out>Отдалить</button>
    <button type="button" data-zoom-pan-reset>Сбросить</button>
    <button type="button" data-zoom-pan-remount>Перезапустить стенд</button>
    <button type="button" data-zoom-pan-destroy>Отключить стенд</button>
  </div>

  <DialogShell
    id="zoom-preview-hotspot-dialog"
    title="Деталь картины"
    description="Техническая карточка выбранной hotspot-точки."
  >
    <p class="zoom-preview__dialog-label" data-hotspot-dialog-label></p>
    <h3 data-hotspot-dialog-title></h3>
    <p data-hotspot-dialog-text></p>
    <div slot="actions">
      <button type="button" data-hotspot-dialog-close>Закрыть</button>
    </div>
  </DialogShell>
</section>

<script>
  import "../../scripts/zoom-pan-preview";
</script>

<style>
  .zoom-preview {
    display: grid;
    gap: var(--space-4);
  }

  .zoom-preview__viewport {
    position: relative;
    width: min(100%, 44rem);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 0.5rem solid var(--color-wood-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    box-shadow: var(--shadow-surface);
    touch-action: none;
    user-select: none;
  }

  .zoom-preview__viewport[data-zoom-pan-dragging="true"] {
    cursor: grabbing;
  }

  .zoom-preview__content {
    position: absolute;
    inset: 0 auto auto 0;
    will-change: transform;
    cursor: grab;
  }

  .zoom-preview__content img {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .zoom-preview__hotspot {
    position: absolute;
    z-index: 2;
    display: grid;
    width: 3rem;
    height: 3rem;
    margin: -1.5rem 0 0 -1.5rem;
    place-items: center;
    border: 2px solid rgb(255 255 255 / 82%);
    border-radius: var(--radius-round);
    color: #fff;
    background: rgb(47 36 25 / 76%);
    box-shadow:
      0 0 0 0.45rem rgb(215 163 58 / 20%),
      var(--shadow-surface);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .zoom-preview__hotspot:hover,
  .zoom-preview__hotspot:focus-visible,
  .zoom-preview__hotspot[aria-pressed="true"] {
    background: var(--color-accent-strong);
    outline: 3px solid rgb(255 255 255 / 86%);
    outline-offset: 0.2rem;
  }

  .zoom-preview__hotspot[data-viewed="true"] {
    border-color: var(--color-success);
  }

  .zoom-preview__status,
  .zoom-preview__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .zoom-preview__status {
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
  }

  .zoom-preview__actions button {
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(255 255 255 / 32%);
    border-radius: var(--radius-pill);
    color: #fff;
    background: var(--color-wood-strong);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .zoom-preview__actions button:hover:not(:disabled),
  .zoom-preview__actions button:focus-visible {
    background: var(--color-accent-strong);
  }

  .zoom-preview__dialog-label {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .zoom-preview :global(.dialog-shell h3) {
    margin: 0 0 var(--space-3);
    color: var(--color-text);
    font-size: var(--font-size-heading-sm);
  }

  .zoom-preview :global(.dialog-shell__actions button) {
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: #fff;
    background: var(--color-accent-strong);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .zoom-preview__actions button:disabled {
    color: rgb(255 255 255 / 72%);
    background: rgb(47 36 25 / 54%);
    cursor: not-allowed;
    opacity: 1;
  }
</style>
