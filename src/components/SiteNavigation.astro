---
import { withBasePath, withoutBasePath } from "../utils/site-path";

interface Props {
  currentPath: string;
}

interface NavigationItem {
  href: string;
  label: string;
  section: "home" | "artist" | "experience" | "works" | "archive";
}

const { currentPath } = Astro.props;

const navigationItems: NavigationItem[] = [
  { href: "/", label: "Главная", section: "home" },
  { href: "/artist/", label: "Художник", section: "artist" },
  {
    href: "/experience/",
    label: "Интерактивный маршрут",
    section: "experience",
  },
  { href: "/works/", label: "Каталог", section: "works" },
  { href: "/archive/", label: "Архив", section: "archive" },
];

const projectPath = withoutBasePath(currentPath);
const normalizedPath =
  projectPath === "/" ? projectPath : `${projectPath.replace(/\/+$/, "")}/`;

const isCurrentSection = (section: NavigationItem["section"]) => {
  if (section === "home") {
    return normalizedPath === "/";
  }

  if (section === "works") {
    return ["/works/", "/series/"].some((path) =>
      normalizedPath.startsWith(path),
    );
  }

  return normalizedPath.startsWith(`/${section}/`);
};
---

<nav class="site-navigation" aria-label="Основная навигация" data-menu-root>
  <div class="site-navigation__top">
    <a
      class="site-navigation__identity"
      href={withBasePath("/")}
      aria-label="Иван Кугач — на главную"
    >
      <span class="site-navigation__name">Иван Кугач</span>
      <span class="site-navigation__caption">Мастерская художника</span>
    </a>

    <button
      class="site-navigation__menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation-panel"
      data-menu-toggle
    >
      <span>Меню</span>
      <span class="site-navigation__menu-icon" aria-hidden="true"></span>
    </button>
  </div>

  <div
    class="site-navigation__panel"
    id="site-navigation-panel"
    data-menu-panel
  >
    <ul class="site-navigation__list" data-menu-links>
      {
        navigationItems.map((item) => (
          <li>
            <a
              class="site-navigation__link"
              href={withBasePath(item.href)}
              aria-current={isCurrentSection(item.section) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <label class="site-navigation__theme">
      <span class="site-navigation__theme-label">Тема</span>
      <select class="site-navigation__theme-select" data-theme-control disabled>
        <option value="system">Как в системе</option>
        <option value="light">Светлая</option>
        <option value="dark">Тёмная</option>
      </select>
    </label>
  </div>

  <button
    class="site-navigation__backdrop"
    type="button"
    tabindex="-1"
    aria-label="Закрыть меню"
    data-menu-backdrop
    hidden></button>
</nav>

<style>
  .site-navigation {
    position: relative;
    isolation: isolate;
    display: grid;
    min-width: 0;
    gap: var(--space-5);
    padding: var(--header-safe-inset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        110deg,
        color-mix(
          in srgb,
          var(--color-surface-strong) 82%,
          var(--color-wall-muted)
        ),
        color-mix(in srgb, var(--color-surface) 86%, var(--color-wall))
      ),
      var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .site-navigation[data-menu-open] {
    z-index: var(--layer-overlay);
  }

  .site-navigation__top,
  .site-navigation__panel {
    position: relative;
    z-index: var(--layer-content);
  }

  .site-navigation__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: var(--space-3);
  }

  .site-navigation__panel {
    display: grid;
    gap: var(--space-4);
  }

  .site-navigation__panel[hidden] {
    display: none;
  }

  .site-navigation__menu-toggle {
    display: none;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-surface-strong);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .site-navigation[data-menu-ready] .site-navigation__menu-toggle {
    display: inline-flex;
  }

  .site-navigation__menu-toggle:hover {
    border-color: var(--color-border-strong);
    color: var(--color-accent-strong);
  }

  .site-navigation__menu-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow);
  }

  .site-navigation__menu-icon {
    position: relative;
    width: 1.1rem;
    height: 0.75rem;
    border-block: 2px solid currentColor;
  }

  .site-navigation__menu-icon::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    border-top: 2px solid currentColor;
    content: "";
    transform: translateY(-50%);
  }

  .site-navigation__backdrop {
    position: fixed;
    z-index: var(--layer-background);
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--color-overlay);
    cursor: default;
  }

  .site-navigation__backdrop:not([hidden]) {
    display: block;
  }

  .site-navigation__identity {
    display: grid;
    width: fit-content;
    color: var(--color-text);
    line-height: var(--line-height-tight);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .site-navigation__identity:hover {
    color: var(--color-accent-strong);
  }

  .site-navigation__name {
    font-size: var(--font-size-500);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.015em;
  }

  .site-navigation__caption {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: 0.6875rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .site-navigation__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-navigation__list li {
    min-width: 0;
  }

  .site-navigation__link {
    position: relative;
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-easing-standard),
      background-color var(--motion-duration-fast) var(--motion-easing-standard),
      border-color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .site-navigation__link:hover {
    border-color: var(--color-border-subtle);
    color: var(--color-accent-strong);
    background: var(--color-surface-muted);
  }

  .site-navigation__link[aria-current="page"] {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-strong);
  }

  .site-navigation__link[aria-current="page"]::after {
    position: absolute;
    right: var(--space-3);
    bottom: 0.35rem;
    left: var(--space-3);
    height: 0.18rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    content: "";
    transform: rotate(-1deg);
  }

  .site-navigation__theme {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    width: min(100%, 15rem);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
  }

  .site-navigation__theme-label {
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .site-navigation__theme-select {
    min-width: 0;
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-surface-strong);
    font: inherit;
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
  }

  .site-navigation__theme-select:hover:not(:disabled) {
    border-color: var(--color-border-strong);
  }

  .site-navigation__theme-select:disabled {
    cursor: not-allowed;
    opacity: 0.58;
  }

  .site-navigation__theme-select:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow);
  }

  @media (min-width: 70rem) {
    .site-navigation {
      grid-template-columns: max-content minmax(0, 1fr) max-content;
      align-items: center;
      gap: clamp(var(--space-4), 2vw, var(--space-8));
      min-height: var(--header-navigation-height);
      padding-block: var(--space-3);
      padding-inline: var(--header-safe-inset);
    }

    .site-navigation__top,
    .site-navigation__panel,
    .site-navigation__panel[hidden] {
      display: contents !important;
    }

    .site-navigation__menu-toggle,
    .site-navigation[data-menu-ready] .site-navigation__menu-toggle,
    .site-navigation__backdrop:not([hidden]) {
      display: none;
    }

    .site-navigation__list {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--space-1);
      justify-content: flex-end;
    }

    .site-navigation__link {
      min-height: 2.5rem;
      padding-inline: clamp(var(--space-2), 0.9vw, var(--space-4));
      white-space: nowrap;
    }

    .site-navigation__theme {
      grid-template-columns: max-content 8.25rem;
      gap: var(--space-1);
      width: auto;
    }

    .site-navigation__theme-label {
      padding-inline: 0;
    }
  }

  @media (max-width: 34rem) {
    .site-navigation__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
