---
import Action from "../common/Action.astro";
import FramedArtwork from "../common/FramedArtwork.astro";
import MetaBadge from "../common/MetaBadge.astro";
import type { ArtworkSummary } from "../../types/artwork";
import { withBasePath } from "../../utils/site-path";

interface Props {
  artwork: ArtworkSummary;
  statusLabel: string;
  priceLabel: string;
  presentation?: "card" | "wall";
}

const { artwork, statusLabel, priceLabel, presentation = "card" } = Astro.props;
const primaryImage =
  artwork.images.find((image) => image.role === "primary") ?? artwork.images[0];
const artworkUrl = withBasePath(`/works/${artwork.slug}/`);
const isSold = artwork.availability === "sold";
const statusTone =
  artwork.availability === "available"
    ? "success"
    : artwork.availability === "reserved"
      ? "warning"
      : "neutral";
const actionLabel = isSold
  ? "Узнать о похожих работах"
  : artwork.priceType === "request"
    ? "Уточнить цену"
    : "Запросить покупку";
const actionUrl = `/works/?work=${encodeURIComponent(artwork.id)}#work-inquiry`;
---

<article
  class:list={[
    "artwork-catalog-card",
    `artwork-catalog-card--${artwork.availability}`,
    `artwork-catalog-card--${presentation}`,
  ]}
  aria-labelledby={`artwork-${artwork.id}-title`}
>
  <a class="artwork-catalog-card__media-link" href={artworkUrl} tabindex="-1">
    <FramedArtwork
      src={primaryImage.src}
      alt={primaryImage.alt}
      caption={artwork.series?.title}
      fit="contain"
      slotRatio="landscape"
    />
  </a>

  <div class="artwork-catalog-card__body">
    <div class="artwork-catalog-card__meta">
      <MetaBadge tone={statusTone}>
        {statusLabel}
      </MetaBadge>
      <span>{artwork.year}</span>
    </div>

    <h3 id={`artwork-${artwork.id}-title`}>
      <a href={artworkUrl}>{artwork.title}</a>
    </h3>

    <p>{artwork.shortDescription}</p>

    <dl class="artwork-catalog-card__facts">
      <div>
        <dt>Техника</dt>
        <dd>{artwork.technique}</dd>
      </div>
      <div>
        <dt>Размер</dt>
        <dd>{artwork.dimensions.label}</dd>
      </div>
      <div>
        <dt>Цена</dt>
        <dd>{priceLabel}</dd>
      </div>
    </dl>

    <div class="artwork-catalog-card__actions">
      <Action href={actionUrl} variant={isSold ? "secondary" : "primary"}>
        {actionLabel}
      </Action>
      {
        artwork.series && (
          <Action href={`/series/${artwork.series.slug}/`} variant="quiet">
            Серия
          </Action>
        )
      }
    </div>
  </div>
</article>

<style>
  .artwork-catalog-card {
    display: grid;
    gap: var(--space-4);
    height: 100%;
    padding: clamp(var(--space-4), 3vw, var(--space-5));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
    transition:
      border-color var(--motion-duration-fast) var(--motion-easing-standard),
      box-shadow var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .artwork-catalog-card:focus-within {
    border-color: var(--color-accent);
    box-shadow: var(--focus-ring-shadow), var(--shadow-surface);
  }

  .artwork-catalog-card--sold {
    background: color-mix(
      in srgb,
      var(--color-surface) 82%,
      var(--color-muted)
    );
  }

  .artwork-catalog-card__media-link {
    color: inherit;
    text-decoration: none;
  }

  .artwork-catalog-card__media-link:hover :global(img) {
    transform: scale(1.025);
  }

  .artwork-catalog-card__media-link :global(img) {
    transition: transform var(--motion-duration-medium)
      var(--motion-easing-standard);
  }

  .artwork-catalog-card__body {
    display: grid;
    gap: var(--space-3);
  }

  .artwork-catalog-card__body h3,
  .artwork-catalog-card__body p {
    margin-block-end: 0;
  }

  .artwork-catalog-card__body h3 a {
    color: var(--color-text);
    text-decoration-color: transparent;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .artwork-catalog-card__body h3 a:hover {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }

  .artwork-catalog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
  }

  .artwork-catalog-card__facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .artwork-catalog-card__facts div {
    display: grid;
    gap: var(--space-1);
  }

  .artwork-catalog-card__facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
  }

  .artwork-catalog-card__facts dd {
    margin: 0;
  }

  .artwork-catalog-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .artwork-catalog-card--wall {
    gap: var(--space-5);
    height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .artwork-catalog-card--wall:focus-within {
    border-color: transparent;
    box-shadow: none;
  }

  .artwork-catalog-card--wall .artwork-catalog-card__media-link {
    display: block;
  }

  .artwork-catalog-card--wall .artwork-catalog-card__body {
    position: relative;
    width: calc(100% - clamp(var(--space-3), 4vw, var(--space-8)));
    margin-inline-start: clamp(var(--space-3), 4vw, var(--space-8));
    padding: clamp(var(--space-4), 2.5vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow: var(--shadow-surface);
  }

  .artwork-catalog-card--wall .artwork-catalog-card__body::before {
    position: absolute;
    top: 0;
    left: clamp(var(--space-4), 5vw, var(--space-8));
    width: clamp(2.5rem, 8vw, 5rem);
    height: 0.2rem;
    background: var(--color-accent);
    content: "";
  }

  .artwork-catalog-card--wall .artwork-catalog-card__facts {
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 44rem) {
    .artwork-catalog-card--wall .artwork-catalog-card__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (max-width: 45rem) {
    .artwork-catalog-card--wall .artwork-catalog-card__body {
      width: calc(100% - var(--space-3));
      margin-inline-start: var(--space-3);
    }

    .artwork-catalog-card--wall .artwork-catalog-card__actions,
    .artwork-catalog-card--wall
      .artwork-catalog-card__actions
      :global(.action) {
      width: 100%;
    }
  }
</style>
