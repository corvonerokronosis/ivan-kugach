---
import { withBasePath } from "../../utils/site-path";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "quiet";
  size?: "small" | "medium";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "medium",
  type = "button",
  disabled = false,
  ariaLabel,
  class: customClass,
  ...attributes
} = Astro.props;

const className = [
  "action",
  `action--${variant}`,
  `action--${size}`,
  customClass,
];
const resolvedHref = href && !disabled ? withBasePath(href) : undefined;
---

{
  href ? (
    <a
      {...attributes}
      class:list={className}
      href={resolvedHref}
      aria-label={ariaLabel}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      {...attributes}
      class:list={className}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}

<style>
  .action {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-family-ui);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--motion-duration-fast) var(--motion-easing-standard),
      background-color var(--motion-duration-fast) var(--motion-easing-standard),
      border-color var(--motion-duration-fast) var(--motion-easing-standard),
      box-shadow var(--motion-duration-fast) var(--motion-easing-standard),
      opacity var(--motion-duration-fast) var(--motion-easing-standard),
      transform var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .action:hover:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(calc(-1 * var(--motion-distance-sm)));
  }

  .action:active:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(0);
  }

  .action:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow);
  }

  .action:is(:disabled, [aria-disabled="true"]) {
    opacity: 0.52;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .action[hidden] {
    display: none;
  }

  .action--small {
    min-height: 2.25rem;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-200);
  }

  .action--medium {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-300);
  }

  .action--primary {
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
    box-shadow: var(--shadow-surface);
  }

  .action--primary:hover {
    color: var(--color-text-on-accent);
    background: var(--color-accent);
  }

  .action--secondary {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-strong);
  }

  .action--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
    background: var(--color-surface-muted);
  }

  .action--secondary:active:not(:disabled, [aria-disabled="true"]) {
    background: var(--color-surface);
  }

  .action--quiet {
    color: var(--color-accent-strong);
    background: transparent;
  }

  .action--quiet:hover {
    color: var(--color-accent);
    background: var(--color-accent-muted);
  }

  .action--quiet:active:not(:disabled, [aria-disabled="true"]) {
    color: var(--color-accent-strong);
    background: color-mix(in srgb, var(--color-accent-muted) 72%, transparent);
  }
</style>
