---
import OptimizedImage from "./OptimizedImage.astro";

type MediaSlotRatio =
  | "near-square"
  | "landscape"
  | "portrait"
  | "square"
  | "wide";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  variant?: "hero" | "feature" | "thumbnail" | "detail";
  fit: "cover" | "contain";
  slotRatio: MediaSlotRatio;
}

const slotAspectRatios: Record<MediaSlotRatio, string> = {
  "near-square": "1.08 / 1",
  landscape: "4 / 3",
  portrait: "3 / 4",
  square: "1 / 1",
  wide: "16 / 10",
};

const {
  src,
  alt,
  caption,
  loading = "lazy",
  priority = false,
  variant = "thumbnail",
  fit,
  slotRatio,
} = Astro.props;
const slotAspectRatio = slotAspectRatios[slotRatio];
---

<figure
  class="framed-artwork"
  style={`--artwork-slot-aspect: ${slotAspectRatio}`}
  data-media-fit={fit}
  data-media-slot={slotRatio}
>
  <div class="framed-artwork__frame">
    <div class="framed-artwork__mat">
      <OptimizedImage
        src={src}
        alt={alt}
        variant={variant}
        fit={fit}
        loading={loading}
        priority={priority}
        class="framed-artwork__image"
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .framed-artwork {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .framed-artwork__frame {
    display: grid;
    aspect-ratio: var(--artwork-slot-aspect);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: var(--frame-padding);
    border: var(--frame-border-width) solid var(--color-wood-strong);
    border-radius: var(--frame-radius);
    background:
      linear-gradient(135deg, var(--color-lamp-muted), transparent 34%),
      var(--color-wood);
    box-shadow:
      inset 0 0 0 var(--frame-inner-border-width)
        color-mix(in srgb, var(--color-lamp) 24%, transparent),
      var(--shadow-frame);
  }

  .framed-artwork__mat {
    display: grid;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: var(--frame-mat-padding);
    background: var(--color-linen);
    box-shadow: var(--shadow-inset-border);
  }

  .framed-artwork :global(.framed-artwork__image) {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  .framed-artwork figcaption {
    margin-inline: var(--space-2);
    color: var(--framed-artwork-caption-color, var(--color-text-muted));
    font-size: var(--font-size-200);
    font-style: italic;
  }
</style>
