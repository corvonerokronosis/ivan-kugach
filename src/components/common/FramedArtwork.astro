---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  loading?: "eager" | "lazy";
  fit?: "cover" | "contain";
  aspectRatio?: string;
}

const {
  src,
  alt,
  caption,
  loading = "lazy",
  fit = "cover",
  aspectRatio = "4 / 3",
} = Astro.props;
---

<figure
  class={`framed-artwork framed-artwork--${fit}`}
  style={`--artwork-aspect: ${aspectRatio}`}
>
  <div class="framed-artwork__frame">
    <div class="framed-artwork__mat">
      <img src={src} alt={alt} loading={loading} decoding="async" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .framed-artwork {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .framed-artwork__frame {
    padding: clamp(0.65rem, 2vw, 1.1rem);
    border: 0.45rem solid var(--color-wood-strong);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 20%), transparent 34%),
      var(--color-wood);
    box-shadow:
      inset 0 0 0 0.2rem rgb(235 199 129 / 24%),
      var(--shadow-raised);
  }

  .framed-artwork__mat {
    aspect-ratio: var(--artwork-aspect);
    padding: clamp(0.35rem, 1vw, 0.7rem);
    background: var(--color-linen);
    box-shadow: inset 0 0 0 1px rgb(41 29 20 / 18%);
    overflow: hidden;
  }

  .framed-artwork img {
    width: 100%;
    height: 100%;
  }

  .framed-artwork--cover img {
    object-fit: cover;
  }

  .framed-artwork--contain img {
    object-fit: contain;
  }

  .framed-artwork figcaption {
    margin-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    font-style: italic;
  }
</style>
