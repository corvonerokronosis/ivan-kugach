---
interface Props {
  value: number;
  max?: number;
  label: string;
  valueLabel?: string;
}

const { value, max = 100, label, valueLabel } = Astro.props;
const safeMax = max > 0 ? max : 100;
const safeValue = Math.min(Math.max(value, 0), safeMax);
const percentage = Math.round((safeValue / safeMax) * 100);
---

<div class="progress-indicator">
  <div class="progress-indicator__labels">
    <span>{label}</span>
    <span>{valueLabel ?? `${percentage}%`}</span>
  </div>
  <progress value={safeValue} max={safeMax}>{percentage}%</progress>
</div>

<style>
  .progress-indicator {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }

  .progress-indicator__labels {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
  }

  .progress-indicator progress {
    width: 100%;
    height: 0.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgb(41 29 20 / 14%);
    overflow: hidden;
  }

  .progress-indicator progress::-webkit-progress-bar {
    border-radius: inherit;
    background: rgb(41 29 20 / 14%);
  }

  .progress-indicator progress::-webkit-progress-value {
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--palette-paint-yellow)
    );
  }

  .progress-indicator progress::-moz-progress-bar {
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--palette-paint-yellow)
    );
  }
</style>
