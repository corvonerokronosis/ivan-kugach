---
interface Props {
  value: number;
  max?: number;
  label: string;
  valueLabel?: string;
}

const { value, max = 100, label, valueLabel } = Astro.props;
const safeMax = max > 0 ? max : 100;
const safeValue = Math.min(Math.max(value, 0), safeMax);
const percentage = Math.round((safeValue / safeMax) * 100);
---

<div class="progress-indicator">
  <div class="progress-indicator__labels">
    <span>{label}</span>
    <span>{valueLabel ?? `${percentage}%`}</span>
  </div>
  <progress value={safeValue} max={safeMax} aria-label={label}>
    {percentage}%
  </progress>
</div>

<style>
  .progress-indicator {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }

  .progress-indicator__labels {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  .progress-indicator progress {
    width: 100%;
    height: 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface-muted);
    overflow: hidden;
  }

  .progress-indicator progress::-webkit-progress-bar {
    border-radius: inherit;
    background: var(--color-surface-muted);
  }

  .progress-indicator progress::-webkit-progress-value {
    border-radius: inherit;
    background: var(--color-accent-strong);
  }

  .progress-indicator progress::-moz-progress-bar {
    border-radius: inherit;
    background: var(--color-accent-strong);
  }
</style>
