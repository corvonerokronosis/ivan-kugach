---
import "../styles/studio.css";
---

<div class="studio-decoration" aria-hidden="true">
  <div class="studio-decoration__frame studio-decoration__frame--large"></div>
  <div class="studio-decoration__frame studio-decoration__frame--small"></div>

  <div class="studio-decoration__paint-shelf">
    <span
      class="studio-decoration__paint-tube studio-decoration__paint-tube--red"
    ></span>
    <span
      class="studio-decoration__paint-tube studio-decoration__paint-tube--blue"
    ></span>
    <span
      class="studio-decoration__paint-tube studio-decoration__paint-tube--green"
    ></span>
    <span class="studio-decoration__paint-jar"></span>
  </div>

  <div
    class="studio-decoration__floor-canvas studio-decoration__floor-canvas--rear"
  >
  </div>
  <div
    class="studio-decoration__floor-canvas studio-decoration__floor-canvas--front"
  >
  </div>
</div>
