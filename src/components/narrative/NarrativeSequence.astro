---
import type { NarrativeSequence } from "../../types/narrative";

interface Props {
  id: string;
  sequence: NarrativeSequence;
  initialIndex?: number;
}

const { id, sequence, initialIndex = 0 } = Astro.props;
const slides = [...sequence.slides].sort((a, b) => a.order - b.order);
const safeInitialIndex = Math.max(0, Math.min(slides.length - 1, initialIndex));
---

<section
  id={id}
  class="narrative-sequence"
  data-narrative-sequence
  data-sequence-id={sequence.id}
  data-completion-action={sequence.completionAction}
  data-completion-label={sequence.completionLabel}
  data-initial-index={safeInitialIndex}
  tabindex="0"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-lead ${id}-keyboard-hint`}
>
  <header class="narrative-sequence__header">
    <div>
      <p class="narrative-sequence__eyebrow">{sequence.eyebrow}</p>
      <h2 id={`${id}-title`}>Сюжетная последовательность</h2>
      <p id={`${id}-lead`} class="narrative-sequence__lead">
        {sequence.lead}
      </p>
    </div>
    <p class="narrative-sequence__counter" aria-live="polite">
      <span data-narrative-counter>
        Окно {safeInitialIndex + 1} из {slides.length}
      </span>
      <span aria-hidden="true"> · </span>
      <span>Блок: {sequence.eyebrow.toLocaleLowerCase("ru-RU")}</span>
    </p>
  </header>

  <div class="narrative-sequence__viewport" aria-live="polite">
    {
      slides.map((slide, index) => (
        <article
          class="narrative-slide"
          data-narrative-slide
          data-slide-id={slide.id}
          hidden={index !== safeInitialIndex}
        >
          <div class="narrative-slide__media">
            <img src={slide.image.src} alt={slide.image.alt} />
            <p>{slide.image.caption}</p>
          </div>

          <div class="narrative-slide__copy">
            <div class="narrative-slide__meta" aria-label="Метаданные">
              {slide.meta.map((item) => (
                <span>{item}</span>
              ))}
            </div>
            <h3>{slide.title}</h3>
            <p class="narrative-slide__text">{slide.text}</p>
            <aside class="narrative-slide__secondary">
              <strong>Что происходит сейчас</strong>
              <p>{slide.secondaryText}</p>
            </aside>
          </div>
        </article>
      ))
    }
  </div>

  <footer class="narrative-sequence__controls">
    <button
      class="narrative-control narrative-control--quiet"
      type="button"
      data-narrative-previous
      aria-keyshortcuts="ArrowLeft"
      disabled={safeInitialIndex === 0}
    >
      Назад
    </button>
    <div class="narrative-sequence__actions">
      <button
        class="narrative-control narrative-control--secondary"
        type="button"
        data-narrative-skip
      >
        {sequence.skipLabel}
      </button>
      <button
        class="narrative-control narrative-control--primary"
        type="button"
        data-narrative-next
        aria-keyshortcuts="ArrowRight"
      >
        {
          safeInitialIndex === slides.length - 1
            ? sequence.completionLabel
            : "Далее"
        }
      </button>
    </div>
  </footer>

  <p id={`${id}-keyboard-hint`} class="narrative-sequence__keyboard-hint">
    Используйте стрелки влево и вправо для перехода между окнами.
  </p>
</section>

<script>
  import "../../scripts/narrative-sequence";
</script>

<style>
  .narrative-sequence {
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-4), 3vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 32%), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .narrative-sequence:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow), var(--shadow-surface);
  }

  .narrative-sequence__header {
    display: grid;
    gap: var(--space-4);
    align-items: end;
  }

  .narrative-sequence__eyebrow,
  .narrative-sequence__counter,
  .narrative-sequence__keyboard-hint {
    font-family: var(--font-family-ui);
  }

  .narrative-sequence__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .narrative-sequence__header h2 {
    margin: 0;
    font-size: var(--font-size-heading-sm);
  }

  .narrative-sequence__lead {
    max-width: 48rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }

  .narrative-sequence__counter {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
  }

  .narrative-sequence__viewport {
    min-width: 0;
  }

  .narrative-slide {
    display: grid;
    gap: var(--space-5);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--color-surface-strong);
    animation: narrative-slide-in var(--motion-duration-slow)
      var(--motion-easing-enter);
  }

  .narrative-slide[hidden] {
    display: none;
  }

  .narrative-slide__media {
    display: grid;
    align-content: start;
    background: var(--color-wood-strong);
  }

  .narrative-slide__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    max-height: 32rem;
    object-fit: cover;
  }

  .narrative-slide__media p {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: rgb(255 245 224 / 78%);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    line-height: 1.45;
  }

  .narrative-slide__copy {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding: clamp(var(--space-4), 3vw, var(--space-7));
  }

  .narrative-slide__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .narrative-slide__meta span {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    background: var(--color-surface-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .narrative-slide__copy h3 {
    margin: 0;
    font-size: var(--font-size-heading-md);
    line-height: var(--line-height-tight);
  }

  .narrative-slide__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
  }

  .narrative-slide__secondary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-left: 0.25rem solid var(--color-accent);
    background: var(--color-accent-muted);
  }

  .narrative-slide__secondary strong {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
  }

  .narrative-slide__secondary p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .narrative-sequence__controls,
  .narrative-sequence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .narrative-sequence__controls {
    justify-content: space-between;
  }

  .narrative-control {
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-300);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition:
      transform var(--motion-duration-fast) var(--motion-easing-standard),
      opacity var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .narrative-control:hover:not(:disabled) {
    transform: translateY(calc(-1 * var(--motion-distance-sm)));
  }

  .narrative-control:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .narrative-control--primary {
    color: var(--color-text-on-accent);
    background: var(--color-accent-strong);
  }

  .narrative-control--secondary {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-strong);
  }

  .narrative-control--quiet {
    color: var(--color-accent-strong);
    background: transparent;
  }

  .narrative-sequence__keyboard-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-100);
    text-align: center;
  }

  @keyframes narrative-slide-in {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance-md));
    }
  }

  @media (min-width: 58rem) {
    .narrative-sequence__header {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .narrative-slide {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(22rem, 1.1fr);
    }
  }

  @media (max-width: 42rem) {
    .narrative-sequence {
      border-radius: var(--radius-xl);
    }

    .narrative-slide__media img {
      min-height: 13rem;
    }

    .narrative-sequence__controls,
    .narrative-sequence__actions,
    .narrative-control {
      width: 100%;
    }
  }
</style>
