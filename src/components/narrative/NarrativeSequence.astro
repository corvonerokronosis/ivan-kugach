---
import type { NarrativeSequence } from "../../types/narrative";
import Action from "../common/Action.astro";
import OptimizedImage from "../common/OptimizedImage.astro";

interface Props {
  id: string;
  sequence: NarrativeSequence;
  initialIndex?: number;
  headingLevel?: "h1" | "h2";
}

const { id, sequence, initialIndex = 0, headingLevel = "h2" } = Astro.props;
const slides = [...sequence.slides].sort((a, b) => a.order - b.order);
const safeInitialIndex = Math.max(0, Math.min(slides.length - 1, initialIndex));
const Heading = headingLevel;
---

<section
  id={id}
  class="narrative-sequence"
  data-narrative-sequence
  data-sequence-id={sequence.id}
  data-completion-action={sequence.completionAction}
  data-completion-label={sequence.completionLabel}
  data-initial-index={safeInitialIndex}
  tabindex="0"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-lead ${id}-keyboard-hint`}
>
  <header class="narrative-sequence__header">
    <div>
      <span class="narrative-sequence__eyebrow">{sequence.eyebrow}</span>
      <Heading id={`${id}-title`}>Сюжетная последовательность</Heading>
      <p id={`${id}-lead`} class="narrative-sequence__lead">
        {sequence.lead}
      </p>
    </div>
  </header>

  <div class="narrative-sequence__viewport" aria-live="polite">
    {
      slides.map((slide, index) => (
        <article
          class="narrative-slide"
          data-narrative-slide
          data-slide-id={slide.id}
          hidden={index !== safeInitialIndex}
        >
          <div class="narrative-slide__media">
            <OptimizedImage
              src={slide.image.src}
              alt={slide.image.alt}
              variant="detail"
              fit="contain"
            />
            <p>{slide.image.caption}</p>
          </div>

          <div class="narrative-slide__copy">
            <div class="narrative-slide__index-row">
              <span class="narrative-slide__index">
                {String(index + 1).padStart(2, "0")} /{" "}
                {String(slides.length).padStart(2, "0")}
              </span>
              <span class="narrative-slide__progress" aria-hidden="true">
                {slides.map((_, markerIndex) => (
                  <span
                    class:list={{
                      "is-reached": markerIndex <= index,
                      "is-current": markerIndex === index,
                    }}
                  />
                ))}
              </span>
            </div>
            <ul class="narrative-slide__meta" aria-label="Метки сюжетного окна">
              {slide.meta.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <h3>{slide.title}</h3>
            <p class="narrative-slide__text">{slide.text}</p>
            <aside class="narrative-slide__secondary">
              <strong>Что происходит сейчас</strong>
              <p>{slide.secondaryText}</p>
            </aside>
          </div>
        </article>
      ))
    }
  </div>

  <footer class="narrative-sequence__controls">
    <Action
      variant="quiet"
      type="button"
      data-narrative-previous
      aria-keyshortcuts="ArrowLeft"
      disabled={safeInitialIndex === 0}
    >
      Назад
    </Action>
    <div class="narrative-sequence__actions">
      <Action variant="secondary" type="button" data-narrative-skip>
        {sequence.skipLabel}
      </Action>
      <Action type="button" data-narrative-next aria-keyshortcuts="ArrowRight">
        {
          safeInitialIndex === slides.length - 1
            ? sequence.completionLabel
            : "Далее"
        }
      </Action>
    </div>
  </footer>

  <p id={`${id}-keyboard-hint`} class="narrative-sequence__keyboard-hint">
    Используйте стрелки влево и вправо для перехода между окнами.
  </p>
</section>

<script>
  import "../../scripts/narrative-sequence";
</script>

<style>
  .narrative-sequence {
    display: grid;
    gap: var(--space-6);
    padding: clamp(var(--space-5), 4vw, var(--space-10));
    overflow: clip;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(
        circle at 72% 10%,
        var(--color-lamp-glow),
        transparent 29rem
      ),
      linear-gradient(135deg, var(--color-surface), var(--color-surface-strong));
    box-shadow: var(--shadow-raised);
    scroll-margin-top: var(--header-scroll-offset);
  }

  .narrative-sequence:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow), var(--shadow-surface);
  }

  .narrative-sequence__header {
    display: grid;
    gap: var(--space-4);
    align-items: end;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .narrative-sequence__keyboard-hint {
    font-family: var(--font-family-ui);
  }

  .narrative-sequence__header :is(h1, h2) {
    max-width: 18ch;
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-heading-lg);
    hyphens: none;
    overflow-wrap: normal;
  }

  .narrative-sequence__eyebrow,
  .narrative-slide__index,
  .narrative-slide__meta {
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .narrative-sequence__lead {
    max-width: 43rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
  }

  .narrative-sequence__viewport {
    min-width: 0;
  }

  .narrative-slide {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-10));
    align-items: stretch;
    animation: narrative-slide-in var(--motion-duration-slow)
      var(--motion-easing-enter);
  }

  .narrative-slide[hidden] {
    display: none;
  }

  .narrative-slide__media {
    display: grid;
    grid-template-rows: minmax(18rem, 1fr) auto;
    align-content: start;
    overflow: hidden;
    border: var(--frame-border-width) solid var(--color-wood-strong);
    border-radius: var(--frame-radius);
    background: var(--color-wood-strong);
    box-shadow: var(--shadow-frame);
    transform: rotate(-0.5deg);
  }

  .narrative-slide__media :global(.optimized-image) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: var(--frame-mat-padding);
    background: var(--color-linen);
  }

  .narrative-slide__media p {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-muted-on-dark);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    line-height: 1.45;
  }

  .narrative-slide__copy {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding: clamp(var(--space-2), 2vw, var(--space-5)) 0;
  }

  .narrative-slide__index-row {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .narrative-slide__index {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
  }

  .narrative-slide__progress {
    display: grid;
    width: min(13rem, 100%);
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-2);
  }

  .narrative-slide__progress > span {
    height: 0.1875rem;
    background: var(--color-border);
  }

  .narrative-slide__progress > .is-reached {
    background: var(--color-accent);
  }

  .narrative-slide__progress > .is-current {
    transform: scaleY(2);
    transform-origin: center;
  }

  .narrative-slide__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .narrative-slide__meta li:not(:last-child)::after {
    margin-left: var(--space-4);
    color: var(--color-accent);
    content: "·";
  }

  .narrative-slide__copy h3 {
    max-width: 17ch;
    margin: 0;
    font-size: var(--font-size-heading-lg);
    line-height: var(--line-height-tight);
  }

  .narrative-slide__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-300), 1.5vw, var(--font-size-400));
    line-height: 1.62;
  }

  .narrative-slide__secondary {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
    padding: var(--space-4) 0 var(--space-1) var(--space-5);
    border-left: 0.1875rem solid var(--color-accent);
  }

  .narrative-slide__secondary strong {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
  }

  .narrative-slide__secondary p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .narrative-sequence__controls,
  .narrative-sequence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .narrative-sequence__controls {
    justify-content: space-between;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .narrative-sequence__keyboard-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-100);
    text-align: left;
  }

  @keyframes narrative-slide-in {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance-md));
    }
  }

  @media (min-width: 58rem) {
    .narrative-slide {
      grid-template-columns: minmax(22rem, 1.08fr) minmax(22rem, 0.92fr);
      min-height: 31rem;
    }
  }

  @media (max-width: 42rem) {
    .narrative-sequence {
      border-radius: var(--radius-xl);
    }

    .narrative-slide__media {
      grid-template-rows: minmax(14rem, 55vw) auto;
      transform: none;
    }

    .narrative-slide__copy h3 {
      font-size: var(--font-size-heading-md);
    }

    .narrative-sequence__controls,
    .narrative-sequence__actions,
    .narrative-sequence__controls :global(.action) {
      width: 100%;
    }
  }
</style>
