---
import type { NarrativeSequence } from "../../types/narrative";
import Action from "../common/Action.astro";
import OptimizedImage from "../common/OptimizedImage.astro";

interface Props {
  id: string;
  sequence: NarrativeSequence;
  initialIndex?: number;
  headingLevel?: "h1" | "h2";
}

const { id, sequence, initialIndex = 0, headingLevel = "h2" } = Astro.props;
const slides = [...sequence.slides].sort((a, b) => a.order - b.order);
const safeInitialIndex = Math.max(0, Math.min(slides.length - 1, initialIndex));
const Heading = headingLevel;
---

<section
  id={id}
  class="narrative-sequence"
  data-narrative-sequence
  data-sequence-id={sequence.id}
  data-completion-action={sequence.completionAction}
  data-completion-label={sequence.completionLabel}
  data-initial-index={safeInitialIndex}
  tabindex="0"
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-lead ${id}-keyboard-hint`}
>
  <header class="narrative-sequence__header">
    <div>
      <Heading id={`${id}-title`}>Сюжетная последовательность</Heading>
      <p id={`${id}-lead`} class="narrative-sequence__lead">
        {sequence.lead}
      </p>
    </div>
  </header>

  <div class="narrative-sequence__viewport" aria-live="polite">
    {
      slides.map((slide, index) => (
        <article
          class="narrative-slide"
          data-narrative-slide
          data-slide-id={slide.id}
          hidden={index !== safeInitialIndex}
        >
          <div class="narrative-slide__media">
            <OptimizedImage
              src={slide.image.src}
              alt={slide.image.alt}
              variant="detail"
              fit="cover"
            />
            <p>{slide.image.caption}</p>
          </div>

          <div class="narrative-slide__copy">
            <h3>{slide.title}</h3>
            <p class="narrative-slide__text">{slide.text}</p>
            <aside class="narrative-slide__secondary">
              <strong>Что происходит сейчас</strong>
              <p>{slide.secondaryText}</p>
            </aside>
          </div>
        </article>
      ))
    }
  </div>

  <footer class="narrative-sequence__controls">
    <Action
      variant="quiet"
      type="button"
      data-narrative-previous
      aria-keyshortcuts="ArrowLeft"
      disabled={safeInitialIndex === 0}
    >
      Назад
    </Action>
    <div class="narrative-sequence__actions">
      <Action variant="secondary" type="button" data-narrative-skip>
        {sequence.skipLabel}
      </Action>
      <Action type="button" data-narrative-next aria-keyshortcuts="ArrowRight">
        {
          safeInitialIndex === slides.length - 1
            ? sequence.completionLabel
            : "Далее"
        }
      </Action>
    </div>
  </footer>

  <p id={`${id}-keyboard-hint`} class="narrative-sequence__keyboard-hint">
    Используйте стрелки влево и вправо для перехода между окнами.
  </p>
</section>

<script>
  import "../../scripts/narrative-sequence";
</script>

<style>
  .narrative-sequence {
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-4), 3vw, var(--space-7));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 32%), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .narrative-sequence:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-shadow), var(--shadow-surface);
  }

  .narrative-sequence__header {
    display: grid;
    gap: var(--space-4);
    align-items: end;
  }

  .narrative-sequence__keyboard-hint {
    font-family: var(--font-family-ui);
  }

  .narrative-sequence__header :is(h1, h2) {
    margin: 0;
    font-size: var(--font-size-heading-sm);
  }

  .narrative-sequence__lead {
    max-width: 48rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }

  .narrative-sequence__viewport {
    min-width: 0;
  }

  .narrative-slide {
    display: grid;
    gap: var(--space-5);
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--color-surface-strong);
    animation: narrative-slide-in var(--motion-duration-slow)
      var(--motion-easing-enter);
  }

  .narrative-slide[hidden] {
    display: none;
  }

  .narrative-slide__media {
    display: grid;
    align-content: start;
    background: var(--color-wood-strong);
  }

  .narrative-slide__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    max-height: 32rem;
    object-fit: cover;
  }

  .narrative-slide__media p {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: rgb(255 245 224 / 78%);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    line-height: 1.45;
  }

  .narrative-slide__copy {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding: clamp(var(--space-4), 3vw, var(--space-7));
  }

  .narrative-slide__copy h3 {
    margin: 0;
    font-size: var(--font-size-heading-md);
    line-height: var(--line-height-tight);
  }

  .narrative-slide__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
  }

  .narrative-slide__secondary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-left: 0.25rem solid var(--color-accent);
    background: var(--color-accent-muted);
  }

  .narrative-slide__secondary strong {
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
  }

  .narrative-slide__secondary p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .narrative-sequence__controls,
  .narrative-sequence__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .narrative-sequence__controls {
    justify-content: space-between;
  }

  .narrative-sequence__keyboard-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-100);
    text-align: center;
  }

  @keyframes narrative-slide-in {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance-md));
    }
  }

  @media (min-width: 58rem) {
    .narrative-slide {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(22rem, 1.1fr);
    }
  }

  @media (max-width: 42rem) {
    .narrative-sequence {
      border-radius: var(--radius-xl);
    }

    .narrative-slide__media img {
      min-height: 13rem;
    }

    .narrative-sequence__controls,
    .narrative-sequence__actions,
    .narrative-sequence__controls :global(.action) {
      width: 100%;
    }
  }
</style>
