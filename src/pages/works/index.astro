---
import Action from "../../components/common/Action.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import ArtworkCatalogCard from "../../components/works/ArtworkCatalogCard.astro";
import { artworkAvailabilityLabels, getArtworks } from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const artworks = getArtworks();
const activeArtworks = artworks.filter(
  (artwork) => artwork.availability !== "sold",
);
const archiveArtworks = artworks.filter(
  (artwork) => artwork.availability === "sold",
);

function formatPrice(artwork: (typeof artworks)[number]): string {
  return artwork.priceType === "request" ? "Цена по запросу" : artwork.price;
}
---

<BaseLayout
  title="Каталог работ — Иван Кугач"
  description="Каталог доступных, зарезервированных и архивных работ Ивана Кугача."
>
  <SectionHeader
    level="h1"
    eyebrow="Каталог работ"
    title="Каталог работ"
    description="Работы из локального типизированного источника разделены по статусам: основной каталог показывает доступные и зарезервированные произведения, архив — проданные."
  />

  <section class="works-section" aria-labelledby="active-works-title">
    <div class="works-section__header">
      <h2 id="active-works-title">Доступные и зарезервированные</h2>
      <p>Эти карточки остаются в основном каталоге для заявочного сценария.</p>
    </div>
    <ul class="works-grid" aria-label="Работы основного каталога">
      {
        activeArtworks.map((artwork) => (
          <li>
            <ArtworkCatalogCard
              artwork={artwork}
              statusLabel={artworkAvailabilityLabels[artwork.availability]}
              priceLabel={formatPrice(artwork)}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="works-section" aria-labelledby="archive-works-title">
    <div class="works-section__header">
      <h2 id="archive-works-title">Архив</h2>
      <p>
        Проданные работы показываются отдельно и не выглядят свободными для
        покупки.
      </p>
    </div>
    <ul class="works-grid works-grid--archive" aria-label="Архивные работы">
      {
        archiveArtworks.map((artwork) => (
          <li>
            <ArtworkCatalogCard
              artwork={artwork}
              statusLabel={artworkAvailabilityLabels[artwork.availability]}
              priceLabel={formatPrice(artwork)}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <div class="works-actions">
    <Action href="/artist/" variant="secondary">О художнике</Action>
  </div>
</BaseLayout>

<style>
  .works-section {
    display: grid;
    gap: var(--space-5);
  }

  .works-section__header {
    display: grid;
    gap: var(--space-2);
  }

  .works-section__header h2 {
    margin-block-end: 0;
  }

  .works-section__header p {
    color: var(--color-text-muted);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .works-actions {
    display: flex;
  }
</style>
