---
import Action from "../../components/common/Action.astro";
import MessageState from "../../components/common/MessageState.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Каталог работ — Иван Кугач"
  description="Техническая страница будущего каталога работ Ивана Кугача."
>
  <SectionHeader
    level="h1"
    eyebrow="Раздел готовится"
    title="Каталог работ"
    description="Работы, серии и статусы доступности будут перенесены сюда отдельными задачами."
  />
  <MessageState title="Технический маршрут">
    <p>Страница уже участвует в общей навигации и поддерживает прямой вход.</p>
  </MessageState>
  <Action href="/artist/" variant="secondary">О художнике</Action>
</BaseLayout>
