---
import Action from "../../components/common/Action.astro";
import FramedArtwork from "../../components/common/FramedArtwork.astro";
import MessageState from "../../components/common/MessageState.astro";
import MetaBadge from "../../components/common/MetaBadge.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import ArtworkCatalogCard from "../../components/works/ArtworkCatalogCard.astro";
import {
  artworkAvailabilityLabels,
  getArtworksBySeriesId,
  getSeries,
} from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ArtworkSummary } from "../../types/artwork";
import type { Series } from "../../types/series";

interface Props {
  series: Series;
}

export function getStaticPaths() {
  return getSeries().map((series) => ({
    params: {
      slug: series.slug,
    },
    props: {
      series,
    },
  }));
}

const { series } = Astro.props;
const seriesArtworks = getArtworksBySeriesId(series.id);
const availableCount = seriesArtworks.filter(
  (artwork) => artwork.availability !== "sold",
).length;
const soldCount = seriesArtworks.length - availableCount;
const pageTitle = series.seo?.title ?? `${series.title} — серия Ивана Кугача`;
const pageDescription = series.seo?.description ?? series.description;
const pageImage = series.seo?.image ?? series.cover?.src;
const pageImageAlt = series.cover?.alt ?? series.title;

function formatPrice(artwork: ArtworkSummary): string {
  return artwork.priceType === "request"
    ? "Цена по запросу"
    : (artwork.price ?? "Цена по запросу");
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  socialImage={pageImage}
  socialImageAlt={pageImageAlt}
  studioDecoration
>
  <article class="series-page">
    <section class="series-hero" aria-labelledby="series-title">
      <div class="series-hero__header">
        <SectionHeader
          id="series-title"
          level="h1"
          eyebrow="Серия"
          title={series.title}
          description={series.description}
        />

        <div class="series-hero__badges" aria-label="Сводка серии">
          <MetaBadge tone="accent">{seriesArtworks.length} работ</MetaBadge>
          <MetaBadge>{availableCount} в каталоге</MetaBadge>
          <MetaBadge>{soldCount} в архиве</MetaBadge>
        </div>
      </div>

      <div class="series-hero__artwork">
        {
          series.cover ? (
            <FramedArtwork
              src={series.cover.src}
              alt={series.cover.alt}
              caption={series.cover.caption}
              fit="contain"
              priority
              variant="hero"
              slotRatio="landscape"
            />
          ) : (
            <div class="series-hero__placeholder" aria-hidden="true">
              <span>{series.title}</span>
            </div>
          )
        }
      </div>

      <aside
        class="series-hero__record studio-reading-plane"
        aria-labelledby="series-overview-title"
      >
        <h2 id="series-overview-title">О серии</h2>
        <p>{series.description}</p>

        <dl class="series-facts">
          <div>
            <dt>Идентификатор</dt>
            <dd>{series.id}</dd>
          </div>
          <div>
            <dt>Адрес</dt>
            <dd>/series/{series.slug}/</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="series-works" aria-labelledby="series-works-title">
      <div class="series-works__header">
        <h2 id="series-works-title">Работы серии</h2>
        <p>
          Список собирается по стабильному ID серии из локальных данных. Если в
          серию позже добавят или уберут работу, страница перестроится без
          изменения route.
        </p>
      </div>

      {
        seriesArtworks.length > 0 ? (
          <ul class="series-works__hanging">
            {seriesArtworks.map((artwork, index) => (
              <li class={`series-works__item series-works__item--${index + 1}`}>
                <ArtworkCatalogCard
                  artwork={artwork}
                  statusLabel={artworkAvailabilityLabels[artwork.availability]}
                  priceLabel={formatPrice(artwork)}
                  presentation="wall"
                />
              </li>
            ))}
          </ul>
        ) : (
          <div class="series-works__empty">
            <MessageState title="В этой серии пока нет работ">
              <p>
                Пустая серия остаётся валидной страницей: сюда можно вернуться
                после редакционного наполнения, не меняя URL и шаблон.
              </p>
            </MessageState>
          </div>
        )
      }
    </section>

    <div class="series-actions">
      <Action href="/works/" variant="secondary">Вернуться в каталог</Action>
    </div>
  </article>
</BaseLayout>

<style>
  :global(body.has-studio-decoration) {
    overflow-x: clip;
  }

  .series-page,
  .series-hero,
  .series-hero__header,
  .series-hero__record,
  .series-works,
  .series-works__header {
    display: grid;
  }

  .series-page {
    gap: clamp(var(--space-10), 8vw, 7rem);
    padding-block: var(--space-2) var(--space-8);
  }

  .series-hero {
    position: relative;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: min(38rem, calc(100dvh - 8rem));
    gap: var(--space-6) clamp(var(--space-4), 3vw, var(--space-8));
    align-items: center;
    isolation: isolate;
  }

  .series-hero::before {
    position: absolute;
    top: 2%;
    right: -3%;
    z-index: -1;
    width: min(64vw, 46rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-lamp-glow),
      transparent 66%
    );
    content: "";
  }

  .series-hero::after {
    position: absolute;
    right: 1%;
    bottom: var(--space-3);
    left: 5%;
    z-index: -1;
    height: 0.4rem;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-wood-strong) 8% 92%,
      transparent
    );
    box-shadow: 0 var(--space-3) var(--space-6)
      color-mix(in srgb, var(--color-wood-strong) 34%, transparent);
    content: "";
  }

  .series-hero__header {
    z-index: 2;
    grid-column: 1 / 7;
    grid-row: 1;
    align-self: end;
    gap: var(--space-5);
    padding-block-start: var(--space-4);
  }

  .series-hero__header :global(.section-header__title) {
    max-width: 15ch;
    font-size: clamp(2.75rem, 4.2vw, 3.75rem);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: normal;
    word-break: normal;
  }

  .series-hero__header :global(.section-header__description) {
    max-width: 38rem;
    font-size: clamp(var(--font-size-300), 1.7vw, var(--font-size-500));
  }

  .series-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .series-hero__artwork {
    z-index: 1;
    grid-column: 7 / 13;
    grid-row: 1 / 3;
    align-self: center;
    min-width: 0;
    padding-block: var(--space-8) var(--space-12);
    transform: rotate(0.8deg);
  }

  .series-hero__artwork :global(.framed-artwork) {
    width: 100%;
    min-width: 0;
  }

  .series-hero__record {
    z-index: 3;
    grid-column: 1 / 6;
    grid-row: 2;
    align-self: start;
    gap: var(--space-3);
    max-width: 32rem;
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transform: rotate(-0.55deg);
  }

  .series-hero__record::before {
    position: absolute;
    top: 0;
    left: clamp(var(--space-4), 4vw, var(--space-8));
    width: clamp(3rem, 8vw, 5.5rem);
    height: 0.2rem;
    background: var(--color-accent);
    content: "";
  }

  .series-hero__record h2,
  .series-hero__record p,
  .series-works__header h2,
  .series-works__header p {
    margin-block-end: 0;
  }

  .series-hero__record h2,
  .series-works__header h2 {
    font-size: var(--font-size-heading-md);
  }

  .series-hero__record p,
  .series-works__header p {
    color: var(--color-text-muted);
  }

  .series-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-4);
    margin: 0;
    border-block: 1px solid var(--color-border-subtle);
  }

  .series-facts div {
    min-width: 0;
    padding-block: var(--space-3);
  }

  .series-facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
  }

  .series-facts dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .series-hero__placeholder {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    padding: clamp(var(--space-5), 5vw, var(--space-10));
    border: var(--frame-border-width) solid var(--color-wood-strong);
    border-radius: var(--frame-radius);
    color: var(--color-text-on-light);
    background: var(--color-linen);
    box-shadow: var(--shadow-frame);
    text-align: center;
  }

  .series-works {
    gap: clamp(var(--space-8), 6vw, var(--space-12));
  }

  .series-works__header {
    grid-template-columns: minmax(0, 0.75fr) minmax(18rem, 0.55fr);
    gap: clamp(var(--space-5), 5vw, var(--space-12));
    align-items: end;
    padding-block-end: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .series-works__header p {
    justify-self: end;
  }

  .series-works__hanging {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(var(--space-10), 8vw, 7rem)
      clamp(var(--space-5), 4vw, var(--space-10));
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .series-works__item {
    min-width: 0;
  }

  .series-works__item:nth-child(5n + 1) {
    grid-column: 1 / 8;
  }

  .series-works__item:nth-child(5n + 2) {
    grid-column: 8 / 13;
    padding-block-start: clamp(var(--space-8), 8vw, 7rem);
  }

  .series-works__item:nth-child(5n + 3) {
    grid-column: 3 / 11;
  }

  .series-works__item:nth-child(5n + 4) {
    grid-column: 1 / 6;
  }

  .series-works__item:nth-child(5n) {
    grid-column: 6 / 13;
    padding-block-start: clamp(var(--space-6), 5vw, var(--space-12));
  }

  .series-works__empty {
    padding: clamp(var(--space-5), 5vw, var(--space-10));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .series-actions {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
  }

  @media (max-width: 55.99rem) {
    .series-page {
      gap: var(--space-12);
    }

    .series-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      gap: var(--space-8);
    }

    .series-hero__header,
    .series-hero__artwork,
    .series-hero__record {
      grid-column: 1;
      grid-row: auto;
    }

    .series-hero__header {
      padding-block-start: 0;
    }

    .series-hero__header :global(.section-header__title) {
      max-width: none;
    }

    .series-hero__artwork {
      padding-block: 0;
      transform: none;
    }

    .series-hero__record {
      max-width: none;
      transform: none;
    }

    .series-hero::after {
      bottom: calc(-1 * var(--space-4));
    }

    .series-works__header,
    .series-works__hanging {
      grid-template-columns: minmax(0, 1fr);
    }

    .series-works__header {
      align-items: start;
    }

    .series-works__header p {
      justify-self: start;
    }

    .series-works__item:nth-child(n) {
      grid-column: 1;
      padding-block-start: 0;
    }
  }

  @media (max-width: 45rem) {
    .series-hero__header :global(.section-header__title) {
      font-size: clamp(2rem, 10vw, 2.5rem);
    }

    .series-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .series-actions,
    .series-actions :global(.action) {
      width: 100%;
    }
  }
</style>
