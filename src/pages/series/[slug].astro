---
import Action from "../../components/common/Action.astro";
import FramedArtwork from "../../components/common/FramedArtwork.astro";
import MessageState from "../../components/common/MessageState.astro";
import MetaBadge from "../../components/common/MetaBadge.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import ArtworkCatalogCard from "../../components/works/ArtworkCatalogCard.astro";
import {
  artworkAvailabilityLabels,
  getArtworksBySeriesId,
  getSeries,
} from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ArtworkSummary } from "../../types/artwork";
import type { Series } from "../../types/series";

interface Props {
  series: Series;
}

export function getStaticPaths() {
  return getSeries().map((series) => ({
    params: {
      slug: series.slug,
    },
    props: {
      series,
    },
  }));
}

const { series } = Astro.props;
const seriesArtworks = getArtworksBySeriesId(series.id);
const availableCount = seriesArtworks.filter(
  (artwork) => artwork.availability !== "sold",
).length;
const soldCount = seriesArtworks.length - availableCount;
const pageTitle = series.seo?.title ?? `${series.title} — серия Ивана Кугача`;
const pageDescription = series.seo?.description ?? series.description;
const pageImage = series.seo?.image ?? series.cover?.src;
const pageImageAlt = series.cover?.alt ?? series.title;

function formatPrice(artwork: ArtworkSummary): string {
  return artwork.priceType === "request"
    ? "Цена по запросу"
    : (artwork.price ?? "Цена по запросу");
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  socialImage={pageImage}
  socialImageAlt={pageImageAlt}
>
  <SectionHeader
    level="h1"
    eyebrow="Серия"
    title={series.title}
    description={series.description}
  />

  <section class="series-overview" aria-labelledby="series-overview-title">
    <div class="series-overview__copy">
      <div class="series-overview__badges" aria-label="Сводка серии">
        <MetaBadge tone="accent">{seriesArtworks.length} работ</MetaBadge>
        <MetaBadge>{availableCount} в каталоге</MetaBadge>
        <MetaBadge>{soldCount} в архиве</MetaBadge>
      </div>

      <h2 id="series-overview-title">О серии</h2>
      <p>{series.description}</p>

      <dl class="series-facts">
        <div>
          <dt>Идентификатор</dt>
          <dd>{series.id}</dd>
        </div>
        <div>
          <dt>Адрес</dt>
          <dd>/series/{series.slug}/</dd>
        </div>
      </dl>
    </div>

    {
      series.cover ? (
        <FramedArtwork
          src={series.cover.src}
          alt={series.cover.alt}
          caption={series.cover.caption}
          fit="contain"
          priority
          variant="hero"
          slotRatio="landscape"
        />
      ) : (
        <div class="series-overview__placeholder" aria-hidden="true">
          <span>{series.title}</span>
        </div>
      )
    }
  </section>

  <section class="series-works" aria-labelledby="series-works-title">
    <div class="series-works__header">
      <h2 id="series-works-title">Работы серии</h2>
      <p>
        Список собирается по стабильному ID серии из локальных данных. Если в
        серию позже добавят или уберут работу, страница перестроится без
        изменения route.
      </p>
    </div>

    {
      seriesArtworks.length > 0 ? (
        <ul class="series-works__grid">
          {seriesArtworks.map((artwork) => (
            <li>
              <ArtworkCatalogCard
                artwork={artwork}
                statusLabel={artworkAvailabilityLabels[artwork.availability]}
                priceLabel={formatPrice(artwork)}
              />
            </li>
          ))}
        </ul>
      ) : (
        <MessageState title="В этой серии пока нет работ">
          <p>
            Пустая серия остаётся валидной страницей: сюда можно вернуться после
            редакционного наполнения, не меняя URL и шаблон.
          </p>
        </MessageState>
      )
    }
  </section>

  <div class="series-actions">
    <Action href="/works/" variant="secondary">Вернуться в каталог</Action>
  </div>
</BaseLayout>

<style>
  .series-overview,
  .series-works {
    display: grid;
    gap: var(--space-5);
  }

  .series-overview {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  .series-overview__copy,
  .series-works__header {
    display: grid;
    gap: var(--space-3);
  }

  .series-overview__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .series-overview h2,
  .series-works h2,
  .series-overview p,
  .series-works p {
    margin-block-end: 0;
  }

  .series-overview p,
  .series-works__header p {
    color: var(--color-text-muted);
  }

  .series-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .series-facts div {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .series-facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
  }

  .series-facts dd {
    margin: 0;
    font-weight: 700;
  }

  .series-overview__placeholder {
    display: grid;
    min-height: 18rem;
    place-items: center;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
    text-align: center;
  }

  .series-works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .series-actions {
    display: flex;
  }

  @media (min-width: 56rem) {
    .series-overview {
      grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.7fr);
    }
  }
</style>
