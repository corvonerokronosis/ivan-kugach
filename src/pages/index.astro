---
import colorArtwork from "../Kugach_picture_1.png";
import detailsArtwork from "../Kugach_picture_2.png";
import salesArtwork from "../for_sales/DOR_3518.jpg";
import lightArtworkUrl from "../picture_light_shadow/_DOR6258.JPG?url";
import Action from "../components/common/Action.astro";
import FramedArtwork from "../components/common/FramedArtwork.astro";
import InteractiveLaunchCard from "../components/common/InteractiveLaunchCard.astro";
import MetaBadge from "../components/common/MetaBadge.astro";
import { getNarrativeRouteBySequenceId } from "../data/repository";
import BaseLayout from "../layouts/BaseLayout.astro";

const introRoute = getNarrativeRouteBySequenceId("intro");

if (!introRoute) {
  throw new Error('Narrative route "intro" не найден');
}
---

<BaseLayout
  title="Иван Кугач — мастерская художника"
  description="Интерактивный маршрут по живописи Ивана Кугача и каталог доступных работ."
  studioDecoration
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <MetaBadge>Прототип музея Кугача</MetaBadge>
      <h1 id="home-title">Войти в картину и вернуть ей цвет</h1>
      <p class="home-hero__lead">
        Стартовая страница подводит пользователя к интерактиву: коротко
        рассказывает о живописи Кугача, задаёт музейное настроение и даёт
        понятную точку входа в опыт.
      </p>
      <span class="home-hero__brush" aria-hidden="true"></span>
    </div>

    <div class="home-hero__aside">
      <blockquote>
        Мир Кугача держится на тепле повседневности: в его работах важны свет,
        человеческое присутствие и ощущение живой, узнаваемой среды.
      </blockquote>
      <div class="home-hero__actions">
        <Action href={introRoute.pathname}>Перейти к интерактиву</Action>
        <Action href="#interactive-entries" variant="secondary">
          Посмотреть карточки
        </Action>
        <Action href="/works/" variant="quiet">Работы для покупки</Action>
      </div>
      <div class="home-hero__palette" aria-hidden="true">
        <span class="home-hero__palette-hole"></span>
        <span class="home-hero__paint home-hero__paint--red"></span>
        <span class="home-hero__paint home-hero__paint--blue"></span>
        <span class="home-hero__paint home-hero__paint--green"></span>
        <span class="home-hero__paint home-hero__paint--yellow"></span>
      </div>
    </div>
  </section>

  <section
    id="interactive-entries"
    class="home-launch-grid"
    aria-labelledby="interactive-entries-title"
  >
    <h2 id="interactive-entries-title" class="visually-hidden">
      Интерактивы и каталог
    </h2>

    <InteractiveLaunchCard
      headingLevel="h3"
      layout="stacked"
      eyebrow="Первый этап"
      title="Возвращение цвета"
      description="Проведите по картине, чтобы проявить живопись из монохромного слоя. Прогресс идёт быстро, а финальное раскрытие завершает композицию автоматически."
      href="/experience/color-return/"
      actionLabel="Открыть интерактив"
    >
      <FramedArtwork
        slot="media"
        src={colorArtwork.src}
        alt="Интерьер мастерской на картине Ивана Кугача"
        caption="Миниатюра картины и быстрый переход в экран раскрашивания."
        aspectRatio="1.08 / 1"
      />
      <MetaBadge slot="meta">Интерактив</MetaBadge>
      <MetaBadge slot="meta">1 картина</MetaBadge>
      <MetaBadge slot="meta" tone="accent">1–2 минуты</MetaBadge>
      <div slot="details">
        <strong>Описание интерактива</strong>
        <p>
          Короткая подводка к сценарию и обещание того, что пользователь увидит
          после входа.
        </p>
      </div>
    </InteractiveLaunchCard>

    <InteractiveLaunchCard
      headingLevel="h3"
      layout="stacked"
      eyebrow="Второй этап"
      title="Приблизить детали"
      description="Исследуйте вторую картину: приближайте полотно, открывайте точки интереса и читайте небольшие пояснения к заметным фрагментам."
      href="/experience/details/"
      actionLabel="Исследовать картину"
    >
      <FramedArtwork
        slot="media"
        src={detailsArtwork.src}
        alt="Фрагмент здания с памятной табличкой на картине Ивана Кугача"
        caption="Переход к исследованию с приближением и историями деталей."
        aspectRatio="1.08 / 1"
      />
      <MetaBadge slot="meta">Новый сценарий</MetaBadge>
      <MetaBadge slot="meta">Зум и точки</MetaBadge>
      <MetaBadge slot="meta" tone="accent">Свободный просмотр</MetaBadge>
      <div slot="details">
        <strong>Описание интерактива</strong>
        <p>
          При выборе точки вид подлетает к детали, а текст раскрывает её
          небольшую историю.
        </p>
      </div>
    </InteractiveLaunchCard>

    <InteractiveLaunchCard
      headingLevel="h3"
      layout="stacked"
      eyebrow="Третий этап"
      title="Свет в мастерской"
      description="Меняйте свет на картине и смотрите, как тот же мотив становится то архитектурным, то бытовым, то почти вечерним воспоминанием."
      href="/experience/light/"
      actionLabel="Изменить свет"
    >
      <FramedArtwork
        slot="media"
        src={lightArtworkUrl}
        alt="Пейзаж с водой и деревьями для интерактива света"
        caption="Состояние картины меняется через утро, день, вечер и лампу."
        aspectRatio="1.08 / 1"
      />
      <MetaBadge slot="meta">Третий шаг</MetaBadge>
      <MetaBadge slot="meta">Свет</MetaBadge>
      <MetaBadge slot="meta" tone="accent">Мастерская</MetaBadge>
      <div slot="details">
        <strong>Описание интерактива</strong>
        <p>
          Один регулятор управляет температурой и направлением света, а заметки
          помогают читать настроение работы.
        </p>
      </div>
    </InteractiveLaunchCard>

    <InteractiveLaunchCard
      headingLevel="h3"
      layout="stacked"
      eyebrow="Отдельный раздел"
      title="Работы для покупки"
      description="Коммерческий сценарий отделён от интерактивного опыта: здесь можно посмотреть доступные работы, открыть описание и подготовить заявку."
      href="/works/"
      actionLabel="Открыть каталог"
    >
      <FramedArtwork
        slot="media"
        src={salesArtwork.src}
        alt="Берёзовый лес на работе из каталога Ивана Кугача"
        caption="Спокойная страница с каталогом, статусами, ценами и заявкой."
        aspectRatio="1.08 / 1"
      />
      <MetaBadge slot="meta">Заявочная галерея</MetaBadge>
      <MetaBadge slot="meta">5 работ</MetaBadge>
      <MetaBadge slot="meta" tone="accent">Без онлайн-оплаты</MetaBadge>
      <div slot="details">
        <strong>Покупка через заявку</strong>
        <p>
          MVP не бронирует и не принимает оплату автоматически. Наличие и
          условия подтверждаются после связи.
        </p>
      </div>
    </InteractiveLaunchCard>
  </section>

  <section class="home-facts" aria-labelledby="home-facts-title">
    <h2 id="home-facts-title" class="visually-hidden">
      Краткое описание проекта
    </h2>
    <article aria-labelledby="home-fact-artist-title">
      <h3 id="home-fact-artist-title">О художнике</h3>
      <p>
        Иван Кугач известен вниманием к тихим сюжетам, человеческому масштабу и
        мягкой живописной атмосфере.
      </p>
      <Action href="/artist/" variant="quiet" size="small">
        Узнать о художнике
      </Action>
    </article>
    <article aria-labelledby="home-fact-prototype-title">
      <h3 id="home-fact-prototype-title">О прототипе</h3>
      <p>
        Пользователь не просто смотрит на произведение, а постепенно раскрывает
        его цвет, словно участвуя в деликатной реставрации.
      </p>
    </article>
    <article aria-labelledby="home-fact-entry-title">
      <h3 id="home-fact-entry-title">О входе</h3>
      <p>
        Каждый сценарий имеет самостоятельный адрес, поэтому его можно открыть
        напрямую и сохранить как обычную ссылку.
      </p>
    </article>
  </section>

  <p slot="footer">Интерактивный музейный прототип о живописи Ивана Кугача.</p>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    gap: var(--space-7);
    overflow: hidden;
    padding: clamp(var(--space-6), 5vw, var(--space-13));
    border: 0.5rem solid var(--color-wood-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        circle at 85% 78%,
        rgb(215 163 58 / 18%),
        transparent 24%
      ),
      linear-gradient(140deg, rgb(255 252 246 / 94%), rgb(242 226 199 / 90%));
    box-shadow:
      inset 0 0 0 0.25rem rgb(235 199 129 / 28%),
      var(--shadow-raised);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgb(255 255 255 / 26%),
      transparent 42%
    );
    pointer-events: none;
    content: "";
  }

  .home-hero__copy,
  .home-hero__aside {
    position: relative;
    z-index: 1;
  }

  .home-hero__copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-4);
  }

  .home-hero h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: var(--font-weight-semibold);
    line-height: 0.94;
  }

  .home-hero__lead {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-400), 2.2vw, var(--font-size-600));
    line-height: 1.5;
  }

  .home-hero__brush {
    width: min(11rem, 55%);
    height: 0.75rem;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(90deg, var(--color-wood) 0 18%, transparent 18%),
      linear-gradient(90deg, var(--color-text-muted), var(--color-wood));
    transform: rotate(-3deg);
  }

  .home-hero__aside {
    display: grid;
    align-content: center;
    gap: var(--space-4);
  }

  .home-hero blockquote {
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    color: var(--color-text-muted);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-surface);
    font-size: var(--font-size-400);
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__palette {
    position: relative;
    justify-self: end;
    width: 8.75rem;
    height: 6.5rem;
    border-radius: 60% 45% 55% 48%;
    background: #cfa46c;
    box-shadow: var(--shadow-surface);
    transform: rotate(-8deg);
  }

  .home-hero__palette-hole,
  .home-hero__paint {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-round);
  }

  .home-hero__palette-hole {
    top: 1.25rem;
    left: 1.35rem;
    border: 0.3rem solid rgb(62 40 27 / 32%);
    background: transparent;
  }

  .home-hero__paint--red {
    top: 1.1rem;
    right: 1.65rem;
    background: var(--palette-paint-red);
  }

  .home-hero__paint--blue {
    right: 1.9rem;
    bottom: 1.2rem;
    background: var(--palette-paint-blue);
  }

  .home-hero__paint--green {
    right: 0.75rem;
    bottom: 2.1rem;
    width: 1rem;
    height: 1rem;
    background: var(--palette-paint-green);
  }

  .home-hero__paint--yellow {
    bottom: 1.05rem;
    left: 2.2rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--palette-paint-yellow);
  }

  .home-launch-grid {
    display: grid;
    gap: var(--space-6);
    scroll-margin-top: var(--space-6);
  }

  .home-facts {
    display: grid;
    gap: var(--space-4);
  }

  .home-facts article {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .home-facts h3 {
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .home-facts p {
    margin: 0;
  }

  @media (min-width: 56rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
      align-items: center;
    }

    .home-launch-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 45rem) {
    .home-hero {
      padding: var(--space-5);
      border-width: 0.375rem;
      border-radius: var(--radius-lg);
    }

    .home-hero h1 {
      font-size: clamp(2.35rem, 13vw, 3.35rem);
    }

    .home-hero__actions :global(.action) {
      width: 100%;
    }

    .home-hero__palette {
      position: absolute;
      right: -1rem;
      bottom: -1rem;
      opacity: 0.4;
      transform: scale(0.76) rotate(-8deg);
    }
  }
</style>
