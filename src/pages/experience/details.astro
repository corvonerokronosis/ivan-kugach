---
import Action from "../../components/common/Action.astro";
import DetailsExplorer from "../../components/experience/DetailsExplorer.astro";
import { withBasePath } from "../../utils/site-path";
import {
  getHotspots,
  getNarrativeRouteBySequenceId,
} from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const hotspots = getHotspots();
const lightBridgeRoute = getNarrativeRouteBySequenceId("lightBridge");

if (!lightBridgeRoute) {
  throw new Error('Narrative route "lightBridge" не найден');
}

const pageDescription = [
  "Исследуйте детали картины Ивана Кугача:",
  "приближайте полотно, перемещайтесь по нему и открывайте точки с кураторскими комментариями.",
].join(" ");
---

<BaseLayout
  title="Приблизить детали — Иван Кугач"
  description={pageDescription}
  studioDecoration
>
  <section class="details-page" aria-labelledby="details-page-title">
    <div class="details-page__topbar">
      <div class="details-page__title">
        <h1 id="details-page-title">Приблизить детали</h1>
        <p>
          Приближайте изображение, перемещайтесь по полотну и открывайте точки
          взаимодействия. При выборе точки сцена автоматически фокусируется на
          нужной детали.
        </p>
      </div>

      <Action href="/experience/" variant="secondary">К маршруту</Action>
    </div>

    <DetailsExplorer
      {hotspots}
      lightBridgePath={withBasePath(lightBridgeRoute.pathname)}
      catalogPath={withBasePath("/works/")}
    />
  </section>
</BaseLayout>

<script>
  import "../../scripts/details-explorer-page";
</script>

<style>
  .details-page {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
    overflow-x: clip;
  }

  .details-page__topbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: start;
    justify-content: space-between;
  }

  .details-page__title {
    display: grid;
    max-width: 48rem;
    gap: var(--space-2);
  }

  .details-page h1 {
    margin: 0;
    font-size: var(--font-size-heading-lg);
  }

  .details-page__title > p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
  }

  @media (max-width: 45rem) {
    .details-page__topbar,
    .details-page__topbar :global(.action) {
      width: 100%;
    }
  }
</style>
