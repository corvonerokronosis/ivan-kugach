---
import ColorRevealExperience from "../../components/experience/ColorRevealExperience.astro";
import { withBasePath } from "../../utils/site-path";
import Action from "../../components/common/Action.astro";
import { getNarrativeRouteBySequenceId } from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const bridgeRoute = getNarrativeRouteBySequenceId("bridge");

if (!bridgeRoute) {
  throw new Error('Narrative route "bridge" не найден');
}

const pageDescription = [
  "Интерактивный этап маршрута по живописи Ивана Кугача:",
  "проведите по картине, чтобы вернуть цвет и открыть следующий сюжетный блок.",
].join(" ");
---

<BaseLayout
  title="Возвращение цвета — Иван Кугач"
  description={pageDescription}
  studioDecoration
>
  <section class="color-return" aria-labelledby="color-return-title">
    <div class="color-return__topbar studio-reading-plane">
      <div class="color-return__title">
        <h1 id="color-return-title">Возвращение цвета</h1>
        <p>
          Проведите по полотну, чтобы вернуть цвет и открыть историю картины.
        </p>
      </div>

      <Action href="/experience/" variant="secondary">К маршруту</Action>
    </div>

    <ColorRevealExperience bridgePath={withBasePath(bridgeRoute.pathname)} />
  </section>
</BaseLayout>

<script>
  import "../../scripts/color-reveal-page";
</script>

<style>
  .color-return {
    display: grid;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .color-return__topbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: center;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .color-return__title {
    display: grid;
    gap: var(--space-2);
  }

  .color-return h1 {
    margin: 0;
    font-size: var(--font-size-heading-lg);
    max-width: 14ch;
  }

  .color-return__title > p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
    max-width: 52ch;
  }

  @media (max-width: 42rem) {
    .color-return__topbar :global(.action) {
      width: 100%;
    }

    .color-return__topbar {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
