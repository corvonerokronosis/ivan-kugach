---
import Action from "../../components/common/Action.astro";
import LightWorkshop from "../../components/experience/LightWorkshop.astro";
import { withBasePath } from "../../utils/site-path";
import {
  getLightExperienceDefaults,
  getLightStates,
  getLightWorks,
  getNarrativeRouteBySequenceId,
} from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const works = getLightWorks();
const states = getLightStates();
const defaults = getLightExperienceDefaults();
const finaleRoute = getNarrativeRouteBySequenceId("finale");

if (!finaleRoute) {
  throw new Error('Narrative route "finale" не найден');
}

const pageDescription = [
  "Меняйте освещение работ Ивана Кугача и откройте четыре состояния мастерской:",
  "утро, холодный день, вечер и лампу.",
].join(" ");
---

<BaseLayout
  title="Свет в мастерской — Иван Кугач"
  description={pageDescription}
  studioDecoration
>
  <section class="light-page" aria-labelledby="light-page-title">
    <div class="light-page__topbar studio-reading-plane">
      <div class="light-page__title">
        <h1 id="light-page-title">Свет в мастерской</h1>
        <p>
          Выберите работу и проведите свет через несколько состояний мастерской:
          утро, холодный день, вечер и лампу.
        </p>
      </div>

      <Action href="/experience/" variant="secondary">К маршруту</Action>
    </div>

    <LightWorkshop
      {works}
      {states}
      {defaults}
      finalePath={withBasePath(finaleRoute.pathname)}
      catalogPath={withBasePath("/works/")}
    />
  </section>
</BaseLayout>

<script>
  import "../../scripts/light-workshop-page";
</script>

<style>
  .light-page {
    display: grid;
    min-width: 0;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .light-page__topbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: center;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .light-page__title {
    display: grid;
    min-width: 0;
    gap: var(--space-2);
  }

  .light-page h1 {
    margin: 0;
    font-size: var(--font-size-heading-lg);
    max-width: 16ch;
  }

  .light-page__title > p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-400);
    max-width: 62ch;
  }

  @media (max-width: 42rem) {
    .light-page__topbar {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .light-page__topbar :global(.action) {
      width: 100%;
    }
  }
</style>
