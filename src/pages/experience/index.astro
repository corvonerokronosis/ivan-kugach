---
import Action from "../../components/common/Action.astro";
import MessageState from "../../components/common/MessageState.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Интерактивный маршрут — Иван Кугач"
  description="Техническая страница входа в будущий интерактивный маршрут по работам Ивана Кугача."
>
  <SectionHeader
    level="h1"
    eyebrow="Раздел готовится"
    title="Интерактивный маршрут"
    description="Последовательность интерактивов будет перенесена сюда отдельной задачей."
  />
  <MessageState title="Технический маршрут">
    <p>Страница уже участвует в общей навигации и поддерживает прямой вход.</p>
  </MessageState>
  <Action href="/" variant="secondary">Вернуться на главную</Action>
</BaseLayout>
