---
import colorArtwork from "../../assets/images/interactive/color-reveal/kugach-picture-1.png";
import detailsArtwork from "../../assets/images/interactive/details/kugach-picture-2.png";
import lightArtwork from "../../assets/images/interactive/light/dor-6258.jpg";
import Action from "../../components/common/Action.astro";
import FramedArtwork from "../../components/common/FramedArtwork.astro";
import {
  getNarrativeRouteBySequenceId,
  getNarrativeSequences,
} from "../../data/repository";
import BaseLayout from "../../layouts/BaseLayout.astro";

const narrativeSequences = getNarrativeSequences();
const introRoute = getNarrativeRouteBySequenceId("intro");

if (!introRoute) {
  throw new Error('Narrative route "intro" не найден');
}

const pageDescription = [
  "Три последовательных интерактива по живописи Ивана Кугача:",
  "возвращение цвета, исследование деталей и работа со светом.",
].join(" ");
---

<BaseLayout
  title="Интерактивный маршрут — Иван Кугач"
  description={pageDescription}
  studioDecoration
>
  <section class="route-hero" aria-labelledby="route-title">
    <div class="route-hero__copy">
      <h1 id="route-title">
        Смотреть на картину — значит двигаться внутри неё
      </h1>
      <p>
        Маршрут последовательно меняет способ наблюдения: сначала вы возвращаете
        живописи цвет, затем приближаете детали и в финале управляете светом.
        Пройти можно по порядку или начать с любого этапа.
      </p>
      <div class="route-hero__actions">
        <Action href={introRoute.pathname}>Начать с первого этапа</Action>
        <Action href="#route-stages" variant="secondary"> Выбрать этап </Action>
      </div>
    </div>

    <aside class="route-hero__note" aria-label="Как устроен маршрут">
      <span class="route-hero__note-number" aria-hidden="true">01—03</span>
      <h2>Один опыт, три самостоятельных входа</h2>
      <p>
        Последовательное прохождение создаёт цельную историю. Прямые ссылки
        позволяют вернуться к нужной механике отдельно и обновить страницу без
        потери маршрута.
      </p>
      <p>
        Narrative-контент уже вынесен в локальные данные:
        {narrativeSequences.length} блока.
      </p>
    </aside>
  </section>

  <section
    id="route-stages"
    class="route-stages"
    aria-labelledby="stages-title"
  >
    <header class="route-stages__header studio-reading-plane">
      <div>
        <span class="route-stages__eyebrow">Порядок прохождения</span>
        <h2 id="stages-title">От проявления цвета к свету мастерской</h2>
      </div>
      <p>
        Каждый этап открывается на собственной странице. Пока интерактивы
        переносятся из legacy-прототипа, их URL уже доступны как независимые
        точки входа.
      </p>
    </header>

    <ol class="route-list">
      <li class="route-stage">
        <div class="route-stage__rail" aria-hidden="true">
          <span>01</span>
        </div>
        <div class="route-stage__media">
          <FramedArtwork
            src={colorArtwork.src}
            alt="Интерьер мастерской на картине Ивана Кугача"
            caption="Первый взгляд: живопись проступает из монохромного слоя."
            fit="contain"
            slotRatio="near-square"
          />
        </div>
        <div class="route-stage__copy">
          <h3>Возвращение цвета</h3>
          <p>
            Проведите по картине, чтобы постепенно открыть живописный слой.
            Здесь маршрут начинается с простого жеста и внимательного взгляда на
            целую композицию.
          </p>
          <Action href="/experience/color-return/">
            Открыть возвращение цвета
          </Action>
        </div>
      </li>

      <li class="route-stage route-stage--reverse">
        <div class="route-stage__rail" aria-hidden="true">
          <span>02</span>
        </div>
        <div class="route-stage__media">
          <FramedArtwork
            src={detailsArtwork.src}
            alt="Фрагмент здания с памятной табличкой на картине Ивана Кугача"
            caption="Второй взгляд: отдельные фрагменты раскрывают собственные истории."
            fit="contain"
            slotRatio="near-square"
          />
        </div>
        <div class="route-stage__copy">
          <h3>Приблизить детали</h3>
          <p>
            Исследуйте полотно крупным планом, находите точки интереса и
            открывайте короткие пояснения. После общего впечатления маршрут
            переводит внимание к следам времени и сюжета.
          </p>
          <Action href="/experience/details/">Исследовать детали</Action>
        </div>
      </li>

      <li class="route-stage">
        <div class="route-stage__rail" aria-hidden="true">
          <span>03</span>
        </div>
        <div class="route-stage__media">
          <FramedArtwork
            src={lightArtwork.src}
            alt="Пейзаж с водой и деревьями для интерактива света"
            caption="Третий взгляд: один мотив меняется вместе с освещением."
            fit="contain"
            slotRatio="near-square"
          />
        </div>
        <div class="route-stage__copy">
          <h3>Свет в мастерской</h3>
          <p>
            Меняйте освещение и наблюдайте, как утро, день, вечер и лампа
            перестраивают настроение работы. Финальный этап возвращает картину в
            пространство живой мастерской.
          </p>
          <Action href="/experience/light/">Перейти к свету</Action>
        </div>
      </li>
    </ol>
  </section>

  <section class="route-catalog" aria-labelledby="catalog-title">
    <div class="route-catalog__mark" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div>
      <h2 id="catalog-title">Каталог не является четвёртым этапом</h2>
      <p>
        Интерактивный маршрут посвящён наблюдению за живописью. Доступные
        работы, статусы, цены и заявка собраны отдельно, чтобы коммерческий
        сценарий не прерывал музейный опыт.
      </p>
    </div>
    <Action href="/works/" variant="secondary">Открыть каталог работ</Action>
  </section>
</BaseLayout>

<style>
  :global(body.has-studio-decoration .studio-decoration) {
    display: none;
  }

  .route-hero {
    position: relative;
    display: grid;
    min-height: min(39rem, calc(100dvh - 8.5rem));
    gap: clamp(var(--space-7), 5vw, var(--space-12));
    align-items: stretch;
    overflow: clip;
    padding: clamp(var(--space-6), 5vw, var(--space-12));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    color: var(--color-text);
    background:
      radial-gradient(
        circle at 72% 18%,
        var(--color-lamp-glow),
        transparent 32%
      ),
      linear-gradient(125deg, var(--color-surface), var(--color-surface-strong));
    box-shadow: var(--shadow-raised);
  }

  .route-hero::before {
    position: absolute;
    inset: auto 0 0;
    height: 31%;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--color-wood) 14%, transparent)
    );
    pointer-events: none;
    content: "";
  }

  .route-hero__copy,
  .route-hero__note {
    position: relative;
    z-index: 1;
  }

  .route-hero__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
  }

  .route-hero h1 {
    max-width: 11ch;
    margin: 0;
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading);
  }

  .route-hero__copy > p {
    max-width: 39rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-300), 1.7vw, var(--font-size-500));
    line-height: 1.5;
  }

  .route-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .route-hero__note {
    display: grid;
    align-content: space-between;
    gap: var(--space-5);
    min-height: 24rem;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
    border: 1px solid color-mix(in srgb, var(--color-linen) 18%, transparent);
    border-radius: var(--radius-lg);
    color: var(--color-text-on-dark);
    background:
      radial-gradient(
        circle at 85% 8%,
        color-mix(in srgb, var(--color-lamp) 15%, transparent),
        transparent 35%
      ),
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-text) 24%, transparent),
        transparent
      ),
      var(--color-wood-strong);
    box-shadow: var(--shadow-frame);
    transform: rotate(0.7deg);
  }

  .route-hero__note-number {
    color: color-mix(in srgb, var(--color-linen) 34%, transparent);
    font-family: var(--font-family-ui);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-heading);
    line-height: 1;
  }

  .route-hero__note h2 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--font-size-heading-sm);
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .route-hero__note p {
    margin: 0;
    color: var(--color-text-muted-on-dark);
  }

  .route-stages {
    display: grid;
    gap: var(--space-6);
    scroll-margin-top: var(--space-6);
    padding-top: var(--space-6);
  }

  .route-stages__header {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    padding: var(--space-6) clamp(var(--space-4), 4vw, var(--space-8))
      var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .route-stages__header h2,
  .route-catalog h2 {
    max-width: 15ch;
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-heading-lg);
    line-height: var(--line-height-tight);
  }

  .route-stages__header p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .route-stages__eyebrow {
    color: var(--color-accent-strong);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-100);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .route-list {
    display: grid;
    gap: clamp(var(--space-8), 6vw, var(--space-13));
    margin: 0;
    padding: var(--space-6) 0;
    list-style: none;
  }

  .route-stage {
    position: relative;
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-10));
    align-items: center;
    padding: 0 clamp(var(--space-2), 3vw, var(--space-6));
  }

  .route-stage::before {
    position: absolute;
    inset: 12% 0 5% 8%;
    z-index: -1;
    border: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-surface) 58%, transparent);
    clip-path: polygon(1% 4%, 99% 0, 100% 95%, 0 100%);
    content: "";
  }

  .route-stage--reverse::before {
    inset: 8% 7% 7% 0;
    clip-path: polygon(0 0, 99% 4%, 100% 100%, 2% 94%);
  }

  .route-stage__rail {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .route-stage__rail::after {
    width: 100%;
    height: 1px;
    background: var(--color-border);
    content: "";
  }

  .route-stage__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 4vw, var(--space-8));
    border-top: 1px solid var(--color-border);
  }

  .route-stage__copy h3 {
    margin: 0;
    font-size: var(--font-size-heading-md);
    line-height: var(--line-height-tight);
  }

  .route-stage__copy p {
    max-width: 37rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .route-catalog {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: clamp(var(--space-5), 4vw, var(--space-8)) 0;
    border-block: 1px solid var(--color-border);
  }

  .route-catalog h2 {
    font-size: var(--font-size-heading-md);
  }

  .route-catalog p {
    max-width: 48rem;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  .route-catalog__mark {
    display: flex;
    gap: var(--space-2);
    align-items: end;
    min-height: 4rem;
  }

  .route-catalog__mark span {
    display: block;
    width: 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
  }

  .route-catalog__mark span:nth-child(1) {
    height: 2.5rem;
  }

  .route-catalog__mark span:nth-child(2) {
    height: 4rem;
    background: var(--color-accent-strong);
  }

  .route-catalog__mark span:nth-child(3) {
    height: 1.75rem;
    background: color-mix(in srgb, var(--color-accent) 46%, var(--color-wood));
  }

  @media (min-width: 56rem) {
    .route-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    }

    .route-stages__header {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.7fr);
    }

    .route-stage {
      grid-template-columns: 2.5rem minmax(18rem, 1.05fr) minmax(20rem, 0.95fr);
    }

    .route-stage__rail {
      align-self: stretch;
      flex-direction: column;
    }

    .route-stage__rail::after {
      width: 1px;
      height: 100%;
    }

    .route-stage--reverse .route-stage__media {
      grid-column: 3;
    }

    .route-stage--reverse .route-stage__copy {
      grid-column: 2;
      grid-row: 1;
    }

    .route-stage--reverse .route-stage__rail {
      grid-column: 1;
      grid-row: 1;
    }

    .route-catalog {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 45rem) {
    .route-hero {
      padding: var(--space-5);
      border-radius: var(--radius-lg);
    }

    .route-hero__actions,
    .route-hero__actions :global(.action),
    .route-stage__copy :global(.action),
    .route-catalog :global(.action) {
      width: 100%;
    }

    .route-hero__note {
      min-height: 19rem;
      transform: none;
    }

    .route-stage {
      padding: 0;
    }

    .route-stage::before,
    .route-stage--reverse::before {
      inset: 8% 0 2% var(--space-3);
    }
  }
</style>
