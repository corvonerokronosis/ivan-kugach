---
import Action from "../components/common/Action.astro";
import MetaBadge from "../components/common/MetaBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Страница не найдена — Иван Кугач"
  description="Запрошенной страницы нет в мастерской Ивана Кугача. Вернитесь на главную или откройте каталог работ."
  studioDecoration
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__copy">
      <MetaBadge tone="accent">
        <span data-not-found-eyebrow>Маршрут не найден</span>
      </MetaBadge>

      <div class="not-found__heading">
        <span class="not-found__code" aria-hidden="true">404</span>
        <h1 id="not-found-title" data-not-found-title>
          Этой двери нет в мастерской
        </h1>
      </div>

      <p class="not-found__lead" data-not-found-description>
        Возможно, ссылка устарела или в адресе есть опечатка. Отсюда можно
        вернуться к началу или перейти к работам художника.
      </p>

      <div class="not-found__actions">
        <Action href="/">Вернуться на главную</Action>
        <Action href="/works/" variant="secondary">Открыть каталог</Action>
      </div>

      <nav class="not-found__secondary" aria-label="Другие разделы">
        <a href="/experience/">Интерактивный маршрут</a>
        <a href="/artist/">О художнике</a>
      </nav>
    </div>

    <div class="not-found__art" aria-hidden="true">
      <div class="not-found__frame">
        <div class="not-found__mat">
          <div class="not-found__canvas">
            <span class="not-found__canvas-code">404</span>
            <span class="not-found__brush not-found__brush--red"></span>
            <span class="not-found__brush not-found__brush--blue"></span>
            <span class="not-found__brush not-found__brush--yellow"></span>
            <span class="not-found__caption">Место для найденного пути</span>
          </div>
        </div>
      </div>
      <span class="not-found__nail"></span>
    </div>
  </section>

  <p slot="footer">
    Ошибка 404 не прерывает навигацию: главная, каталог и интерактивный маршрут
    остаются доступны.
  </p>
</BaseLayout>

<script>
  const routeContext = {
    work: {
      eyebrow: "Работа не найдена",
      title: "Этой работы нет в текущем каталоге",
      description:
        "Возможно, работа была перемещена, её адрес изменился или ссылка устарела. Откройте каталог, чтобы увидеть актуальную подборку.",
    },
    series: {
      eyebrow: "Серия не найдена",
      title: "Такой серии пока нет в мастерской",
      description:
        "Возможно, адрес серии изменился или ссылка ведёт на ещё не опубликованную подборку. В каталоге собраны доступные сейчас работы.",
    },
  } as const;

  const normalizedPath = window.location.pathname.toLowerCase();
  const context = normalizedPath.startsWith("/works/")
    ? routeContext.work
    : normalizedPath.startsWith("/series/")
      ? routeContext.series
      : undefined;

  if (context) {
    const eyebrow = document.querySelector<HTMLElement>(
      "[data-not-found-eyebrow]",
    );
    const title = document.querySelector<HTMLElement>("[data-not-found-title]");
    const description = document.querySelector<HTMLElement>(
      "[data-not-found-description]",
    );

    if (eyebrow) eyebrow.textContent = context.eyebrow;
    if (title) title.textContent = context.title;
    if (description) description.textContent = context.description;
  }
</script>

<style>
  .not-found {
    position: relative;
    display: grid;
    gap: clamp(var(--space-8), 6vw, var(--space-13));
    align-items: center;
    min-height: min(44rem, calc(100vh - 14rem));
    overflow: hidden;
    padding: clamp(var(--space-6), 6vw, 4.5rem);
    border: 0.5rem solid var(--color-wood-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        circle at 78% 22%,
        rgb(215 163 58 / 24%),
        transparent 26%
      ),
      linear-gradient(145deg, rgb(255 252 246 / 96%), rgb(235 215 183 / 92%));
    box-shadow:
      inset 0 0 0 0.25rem rgb(235 199 129 / 28%),
      var(--shadow-raised);
  }

  .not-found::before {
    position: absolute;
    inset: auto 8% 12% 42%;
    height: 1px;
    background: rgb(94 39 23 / 16%);
    content: "";
    transform: rotate(-3deg);
  }

  .not-found__copy,
  .not-found__art {
    position: relative;
    z-index: 1;
  }

  .not-found__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .not-found__heading {
    display: grid;
    gap: var(--space-2);
  }

  .not-found__code {
    color: var(--color-accent);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-300);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.28em;
  }

  .not-found h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: var(--font-weight-semibold);
    line-height: 0.94;
  }

  .not-found__lead {
    max-width: 39rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-400), 2vw, var(--font-size-600));
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .not-found__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-family-ui);
    font-size: var(--font-size-200);
    font-weight: var(--font-weight-semibold);
  }

  .not-found__art {
    width: min(100%, 28rem);
    justify-self: center;
    padding-top: var(--space-5);
    transform: rotate(2.5deg);
  }

  .not-found__frame {
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 0.7rem solid var(--color-wood-strong);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 18%), transparent 34%),
      var(--color-wood);
    box-shadow:
      inset 0 0 0 0.22rem rgb(235 199 129 / 24%),
      var(--shadow-raised);
  }

  .not-found__mat {
    padding: clamp(var(--space-3), 2vw, var(--space-5));
    background: var(--color-linen);
    box-shadow: inset 0 0 0 1px rgb(41 29 20 / 18%);
  }

  .not-found__canvas {
    position: relative;
    display: grid;
    min-height: 23rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(41 29 20 / 16%);
    background:
      linear-gradient(90deg, rgb(94 39 23 / 4%) 1px, transparent 1px),
      linear-gradient(rgb(94 39 23 / 4%) 1px, transparent 1px),
      var(--palette-parchment-50);
    background-size: 2.5rem 2.5rem;
  }

  .not-found__canvas-code {
    color: var(--color-wood-strong);
    font-family: var(--font-family-display);
    font-size: clamp(6rem, 17vw, 10rem);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    letter-spacing: -0.08em;
    text-shadow: 0.05em 0.05em 0 rgb(215 163 58 / 24%);
  }

  .not-found__brush {
    position: absolute;
    height: 0.65rem;
    border-radius: var(--radius-pill);
    opacity: 0.82;
  }

  .not-found__brush--red {
    top: 24%;
    right: -8%;
    width: 58%;
    background: var(--palette-paint-red);
    transform: rotate(-8deg);
  }

  .not-found__brush--blue {
    bottom: 25%;
    left: -12%;
    width: 64%;
    background: var(--palette-paint-blue);
    transform: rotate(5deg);
  }

  .not-found__brush--yellow {
    right: 14%;
    bottom: 12%;
    width: 32%;
    height: 0.45rem;
    background: var(--palette-paint-yellow);
    transform: rotate(-4deg);
  }

  .not-found__caption {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-200);
    font-style: italic;
  }

  .not-found__nail {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-round);
    background: var(--color-wood-strong);
    box-shadow: 0 0 0 0.25rem rgb(255 245 224 / 36%);
  }

  .not-found__nail::after {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    width: 9rem;
    height: 1px;
    background: var(--color-border);
    content: "";
    transform: translateX(-50%) rotate(-2.5deg);
    transform-origin: center;
  }

  @media (min-width: 56rem) {
    .not-found {
      grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.75fr);
    }
  }

  @media (max-width: 45rem) {
    .not-found {
      min-height: 0;
      padding: var(--space-5);
      border-width: 0.375rem;
      border-radius: var(--radius-lg);
    }

    .not-found h1 {
      font-size: clamp(2.55rem, 13vw, 3.55rem);
    }

    .not-found__actions,
    .not-found__actions :global(.action) {
      width: 100%;
    }

    .not-found__art {
      width: min(100%, 20rem);
    }

    .not-found__canvas {
      min-height: 16rem;
    }
  }
</style>
