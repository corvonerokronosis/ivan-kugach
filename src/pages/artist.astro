---
import Action from "../components/common/Action.astro";
import MessageState from "../components/common/MessageState.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Художник — Иван Кугач"
  description="Техническая страница будущего раздела о художнике Иване Кугаче."
>
  <SectionHeader
    level="h1"
    eyebrow="Раздел готовится"
    title="Художник"
    description="Биография и художественный контекст будут перенесены сюда отдельной задачей."
  />
  <MessageState title="Технический маршрут">
    <p>Страница уже участвует в общей навигации и поддерживает прямой вход.</p>
  </MessageState>
  <Action href="/works/" variant="secondary">Перейти в каталог</Action>
</BaseLayout>
