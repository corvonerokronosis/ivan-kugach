{
  "name": "kugach-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,mjs,ts}\" \"tests/**/*.{js,mjs,ts}\" \"scripts/**/*.mjs\" \"*.{js,mjs}\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{astro,js,mjs,ts,css,md}\" \"tests/**/*.{js,mjs,ts}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs,md}\" \"docs/{Frontend_Rebuild_Backlog,PROJECT_MAP,LEGACY_MIGRATION_CHECKLIST,VISUAL_BASELINE,ENTRYPOINT_CUTOVER_PLAN,PERFORMANCE_BUDGET}.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,mjs,ts,css,md}\" \"tests/**/*.{js,mjs,ts}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs,md}\" \"docs/{Frontend_Rebuild_Backlog,PROJECT_MAP,LEGACY_MIGRATION_CHECKLIST,VISUAL_BASELINE,ENTRYPOINT_CUTOVER_PLAN,PERFORMANCE_BUDGET}.md\"",
    "test:unit": "tsc --ignoreConfig --outDir .tmp/unit-tests --rootDir src --module ESNext --moduleResolution Bundler --target ES2022 --skipLibCheck src/utils/color-reveal-progress.ts src/utils/zoom-pan.ts src/scripts/light-controller.ts && node --test tests/*.test.mjs",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "verify": "npm run check && npm run lint && npm run test:unit && npm run format:check && npm run build && npm run performance:budget"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
