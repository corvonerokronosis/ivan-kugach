# Project-local Codex exec rules for routine Playwright CLI QA on Windows.
#
# Routine QA deliberately uses Playwright CLI's default in-memory browser session
# (no --session / -s). That keeps the action token in a fixed argv position, so
# the rule can allow a concrete set of browser actions instead of allowing every
# command that happens to share a session prefix.
#
# Intentionally DO NOT allow broad pwsh/powershell/cmd wrappers. A shell wrapper
# would both break this literal argv match and create a much wider permission.

prefix_rule(
    pattern = [
        ["npx", "npx.cmd", "C:\\Program Files\\nodejs\\npx.cmd"],
        "--package",
        "@playwright/cli",
        "playwright-cli",
        [
            "snapshot",
            "screenshot",
            "find",
            "click",
            "dblclick",
            "fill",
            "type",
            "drag",
            "hover",
            "select",
            "check",
            "uncheck",
            "dialog-accept",
            "dialog-dismiss",
            "resize",
            "go-back",
            "go-forward",
            "reload",
            "press",
            "keydown",
            "keyup",
            "mousemove",
            "mousedown",
            "mouseup",
            "mousewheel",
            "tab-list",
            "tab-close",
            "tab-select",
            "console",
            "requests",
            "request",
            "generate-locator",
            "highlight",
            "close",
        ],
    ],
    decision = "allow",
    justification = "Allow concrete routine Playwright interactions and autogenerated QA captures without per-step approval.",
    match = [
        "npx.cmd --package @playwright/cli playwright-cli snapshot",
        "npx.cmd --package @playwright/cli playwright-cli screenshot",
        "npx.cmd --package @playwright/cli playwright-cli find Навигация",
        "npx.cmd --package @playwright/cli playwright-cli click e15",
        "npx.cmd --package @playwright/cli playwright-cli fill e8 Example",
        "npx.cmd --package @playwright/cli playwright-cli press Enter",
        "npx.cmd --package @playwright/cli playwright-cli resize 390 844",
        "npx.cmd --package @playwright/cli playwright-cli console",
        "npx.cmd --package @playwright/cli playwright-cli requests",
        "npx.cmd --package @playwright/cli playwright-cli close",
    ],
    not_match = [
        "npx.cmd --package @playwright/cli playwright-cli goto https://example.com/",
        "npx.cmd --package @playwright/cli playwright-cli eval document.title",
        "npx.cmd --package @playwright/cli playwright-cli run-code async page => page.title()",
        "npx.cmd --package @playwright/cli playwright-cli upload ./document.pdf",
        "npx.cmd --package @playwright/cli playwright-cli state-save auth.json",
        "npx.cmd --package @playwright/cli playwright-cli cookie-list",
        "npx.cmd --package @playwright/cli playwright-cli route **/*.jpg --status=404",
        "npx.cmd --package @playwright/cli playwright-cli attach --cdp=msedge",
        "npx.cmd --package @playwright/cli playwright-cli pdf --filename=page.pdf",
        "npx.cmd --package @playwright/cli playwright-cli --session kugach-qa snapshot",
        "npx.cmd --package @playwright/cli playwright-cli -s=kugach-qa snapshot",
        "pwsh.exe -Command npx.cmd --package @playwright/cli playwright-cli snapshot",
        "cmd.exe /c npx.cmd --package @playwright/cli playwright-cli screenshot",
        "npx.cmd --package some-other-package playwright-cli snapshot",
    ],
)

prefix_rule(
    pattern = [
        ["npx", "npx.cmd", "C:\\Program Files\\nodejs\\npx.cmd"],
        "--yes",
        "--package",
        "@playwright/cli",
        "playwright-cli",
        [
            "snapshot",
            "screenshot",
            "find",
            "click",
            "dblclick",
            "fill",
            "type",
            "drag",
            "hover",
            "select",
            "check",
            "uncheck",
            "dialog-accept",
            "dialog-dismiss",
            "resize",
            "go-back",
            "go-forward",
            "reload",
            "press",
            "keydown",
            "keyup",
            "mousemove",
            "mousedown",
            "mouseup",
            "mousewheel",
            "tab-list",
            "tab-close",
            "tab-select",
            "console",
            "requests",
            "request",
            "generate-locator",
            "highlight",
            "close",
        ],
    ],
    decision = "allow",
    justification = "Allow the equivalent npx --yes form for the same interactions and autogenerated QA captures.",
    match = [
        "npx.cmd --yes --package @playwright/cli playwright-cli snapshot",
        "npx.cmd --yes --package @playwright/cli playwright-cli screenshot",
        "npx.cmd --yes --package @playwright/cli playwright-cli click e15",
        "npx.cmd --yes --package @playwright/cli playwright-cli resize 1440 900",
    ],
    not_match = [
        "npx.cmd --yes --package @playwright/cli playwright-cli goto http://127.0.0.1:4321/",
        "npx.cmd --yes --package @playwright/cli playwright-cli run-code async page => page.title()",
        "npx.cmd --yes --package @playwright/cli playwright-cli eval document.title",
        "npx.cmd --yes --package @playwright/cli playwright-cli --session kugach-qa snapshot",
        "npx.cmd --yes --package another-package playwright-cli screenshot",
    ],
)
