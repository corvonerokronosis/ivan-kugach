# Project-local Codex exec rules for Playwright CLI QA on Windows.
# Goal: once a named Playwright session is being used, routine browser actions
# (click/screenshot/snapshot/eval/etc.) should not request approval one by one.
#
# Intentionally DO NOT allow a broad `pwsh -Command` / `powershell -Command`
# prefix: that would effectively allow arbitrary PowerShell outside the sandbox.

prefix_rule(
    pattern = [
        ["npx", "npx.cmd", "C:\\Program Files\\nodejs\\npx.cmd"],
        "--package",
        "@playwright/cli",
        "playwright-cli",
        "--session",
    ],
    decision = "allow",
    justification = "Allow routine @playwright/cli actions in a named QA browser session without per-step approval.",
    match = [
        "npx.cmd --package @playwright/cli playwright-cli --session kugach-qa snapshot",
        "npx.cmd --package @playwright/cli playwright-cli --session kugach-qa click e15",
        "npx.cmd --package @playwright/cli playwright-cli --session kugach-qa screenshot",
        "npx.cmd --package @playwright/cli playwright-cli --session kugach-qa open http://127.0.0.1:4321/ --headed",
    ],
    not_match = [
        "npx.cmd --package @playwright/cli playwright-cli screenshot",
        "npx.cmd --package some-other-package playwright-cli --session kugach-qa screenshot",
        "npx.cmd --package @playwright/cli some-other-cli --session kugach-qa screenshot",
    ],
)

prefix_rule(
    pattern = [
        ["npx", "npx.cmd", "C:\\Program Files\\nodejs\\npx.cmd"],
        "--yes",
        "--package",
        "@playwright/cli",
        "playwright-cli",
        "--session",
    ],
    decision = "allow",
    justification = "Allow the Playwright skill wrapper form that adds --yes while keeping the rule scoped to named @playwright/cli sessions.",
    match = [
        "npx.cmd --yes --package @playwright/cli playwright-cli --session kugach-qa snapshot",
        "npx.cmd --yes --package @playwright/cli playwright-cli --session kugach-qa click e15",
        "npx.cmd --yes --package @playwright/cli playwright-cli --session kugach-qa screenshot",
    ],
    not_match = [
        "npx.cmd --yes --package @playwright/cli playwright-cli screenshot",
        "npx.cmd --yes --package another-package playwright-cli --session kugach-qa screenshot",
    ],
)
